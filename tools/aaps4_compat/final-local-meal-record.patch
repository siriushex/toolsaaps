+        val recorded = try {
+            (1..8).map { offset -> async(Dispatchers.Default) {
+                repo.runTransactionForResultSuspend(InsertLocalManualMealOnce(meal.copy(timestamp = start + offset)))
+            } }.awaitAll().distinct().single()
+        } finally { repo.close() }
+        assertTrue(recorded in start + 1..start + 8)
+        db.close()
+        db = JvmAppDatabaseBuilder().provideAppDatabase("$dir/test.db")
+        val reopened = AppRepository { db }
+        try {
+            assertEquals(recorded, reopened.runTransactionForResultSuspend(InsertLocalManualMealOnce(meal.copy(timestamp = start + 20))))
+            assertEquals(recorded, reopened.localMealRecordedAt(marker, start, start + 8_000, meal.amount))
+            assertNull(reopened.localMealRecordedAt(marker, start, recorded, meal.amount))
+            assertNull(reopened.localMealRecordedAt(marker, recorded + 1, start + 8_000, meal.amount))
+            assertNull(reopened.localMealRecordedAt(marker, start, start + 8_000, meal.amount + 1))
+            assertFailsWith<IllegalStateException> {
+                reopened.runTransactionForResultSuspend(InsertLocalManualMealOnce(meal.copy(amount = meal.amount + 1)))
+            }
+            assertEquals(1, dao.currentLocalMeals(marker).size)
+            val saved = dao.currentLocalMeals(marker).single()
+            reopened.runTransactionForResultSuspend(InsertOrUpdateCarbsTransaction(saved.copy(notes = "edited locally")))
+            assertFailsWith<IllegalStateException> {
+                reopened.runTransactionForResultSuspend(InsertLocalManualMealOnce(meal.copy()))
+            }
+            assertNull(reopened.localMealRecordedAt(marker, start, start + 8_000, meal.amount))
