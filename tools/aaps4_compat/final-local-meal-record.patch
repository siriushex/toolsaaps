--- /dev/null
+++ b/database/impl/src/commonMain/kotlin/app/aaps/database/transactions/InsertLocalManualMealOnce.kt
@@ -0,0 +1,28 @@
+package app.aaps.database.transactions
+
+import app.aaps.database.entities.Carbs
+
+/** Called inside the repository's IMMEDIATE writer transaction, for one immediate carb-only entry. */
+class InsertLocalManualMealOnce(private val meal: Carbs) : Transaction<Long>() {
+    override suspend fun run(): Long {
+        val marker = requireNotNull(meal.notes)
+        require(MARKER.matches(marker) && meal.id == 0L && meal.version == 0 && meal.referenceId == null &&
+            meal.isValid && meal.duration == 0L && meal.timestamp > 0L && meal.amount in 1.0..120.0)
+        val dao = database.carbsDao
+        val current = dao.currentLocalMeals(marker)
+        if (current.isNotEmpty()) {
+            val existing = current.singleOrNull()
+            check(existing != null && existing.isValid && existing.duration == 0L && existing.amount == meal.amount) {
+                "local_meal_record_conflict"
+            }
+            return existing.timestamp
+        }
+        // A renamed or invalidated entry must not be resurrected by replay.
+        check(!dao.hasPriorLocalMeal(marker)) { "local_meal_record_conflict" }
+        dao.insertNewEntry(meal)
+        check(dao.matchesLocalMeal(marker, meal.timestamp, meal.amount)) { "local_meal_not_persisted" }
+        return meal.timestamp
+    }
+
+    private companion object { val MARKER = Regex("copilot:manual:meal:[A-Za-z0-9_-]{1,80}") }
+}
