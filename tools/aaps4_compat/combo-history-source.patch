+package info.nightscout.pump.combov2
+
+import app.aaps.core.interfaces.pump.RetainedPumpHistory
+import app.aaps.core.interfaces.pump.RetainedPumpHistoryRead
+import app.aaps.core.interfaces.pump.RetainedPumpHistoryUnavailable
+import java.util.Collections
+import kotlinx.coroutines.CancellationException
+
+/** Reads the existing writer; never opens another journal or acquires a Bluetooth pump. */
+internal class ComboRetainedHistory private constructor(
+    private val journal: ComboHistoryJournal,
+    private val snapshot: ComboHistoryJournal.Snapshot,
+    override val pumpBinding: String,
+    private val ownsJournal: () -> Boolean
+) : RetainedPumpHistory {
+
+    private var invalid = false
+    override val reads: List<RetainedPumpHistoryRead> = Collections.unmodifiableList(snapshot.reads.map {
+        RetainedPumpHistoryRead(it.id, it.size, it.sha256, it.closed, it.corrupt, it.adverse, it.readFailed)
+    })
+    override val unscopedCorruptReads = snapshot.unscopedCorruptReads
+    override val writerFailed = snapshot.writerFailed
+
+    @Synchronized
+    override fun requireCurrent() {
+        try {
+            check(!invalid && ownsJournal())
+            journal.requireCurrent(snapshot)
+        } catch (e: CancellationException) {
+            invalid = true
+            throw e
+        } catch (e: Exception) {
+            invalid = true
+            throw RetainedPumpHistoryUnavailable()
+        }
+    }
+
+    @Synchronized
+    override fun readChunk(readId: String, offset: Int, byteCount: Int): ByteArray {
+        var content: ByteArray? = null
+        try {
+            requireCurrent()
+            val read = checkNotNull(reads.singleOrNull { it.id == readId })
+            require(offset >= 0 && offset < read.byteCount && offset % CHUNK_BYTES == 0)
+            require(byteCount == minOf(CHUNK_BYTES, read.byteCount - offset))
+            val chunk = journal.readChunk(snapshot, readId, offset, byteCount)
+            content = chunk.bytes()
+            check(chunk.offset == offset && chunk.totalSize == read.byteCount && chunk.sha256 == read.sha256 && content.size == byteCount)
+            requireCurrent()
+            return content
+        } catch (e: CancellationException) {
+            content?.fill(0)
+            invalid = true
+            throw e
+        } catch (e: Exception) {
+            content?.fill(0)
+            invalid = true
+            throw RetainedPumpHistoryUnavailable()
+        }
+    }
+
+    @Synchronized
+    override fun close() {
+        invalid = true
+    }
+
+    override fun toString() = "ComboRetainedHistory(redacted)"
+
+    companion object {
+        private const val CHUNK_BYTES = 32768
+
+        fun open(journal: ComboHistoryJournal, binding: String, ownsJournal: () -> Boolean): RetainedPumpHistory {
+            try {
+                check(ownsJournal())
+                val snapshot = journal.snapshot(binding)
+                return ComboRetainedHistory(journal, snapshot, binding, ownsJournal).also { it.requireCurrent() }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                throw RetainedPumpHistoryUnavailable()
+            }
+        }
+    }
+}
