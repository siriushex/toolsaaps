+package info.nightscout.pump.combov2
+
+import app.aaps.core.interfaces.pump.RetainedPumpHistory
+import app.aaps.core.interfaces.pump.RetainedPumpHistoryUnavailable
+import info.nightscout.comboctl.base.HistoryReadCheckpoint
+import info.nightscout.comboctl.base.HistoryReadCheckpoint.Phase
+import info.nightscout.comboctl.base.HistoryReadObservation
+import java.io.File
+import java.io.RandomAccessFile
+import java.security.MessageDigest
+import kotlinx.coroutines.CancellationException
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ComboRetainedHistoryTest {
+    @TempDir lateinit var root: File
+    private val binding = "a".repeat(64)
+    private val directory get() = File(root, "history")
+
+    private fun checkpoint(phase: Phase, large: Boolean = false) = HistoryReadCheckpoint(
+        phase,
+        HistoryReadObservation(state = if (phase == Phase.END) HistoryReadObservation.State.RETURNED else HistoryReadObservation.State.READING),
+        if (phase == Phase.BLOCK) List(if (large) 4096 else 7) { 0 } else emptyList()
+    )
+
+    private fun complete(journal: ComboHistoryJournal, owner: String = binding, large: Boolean = false) {
+        journal.record(owner, checkpoint(Phase.BEGIN))
+        repeat(if (large) 5 else 1) {
+            journal.record(owner, checkpoint(Phase.BLOCK, large))
+            journal.record(owner, checkpoint(Phase.CONFIRMED))
+        }
+        journal.record(owner, checkpoint(Phase.END))
+    }
+
+    private fun open(journal: ComboHistoryJournal, owns: () -> Boolean = { true }) =
+        ComboRetainedHistory.open(journal, binding, owns)
+
+    private fun refused(block: () -> Unit) {
+        val error = assertThrows(RetainedPumpHistoryUnavailable::class.java, block)
+        assertEquals("Retained pump history unavailable", error.message)
+        assertNull(error.cause)
+    }
+
+    @Test fun exactRetainedBytesAreReadableWithoutASecondWriter() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal, large = true)
+            val source = open(journal)
+            val read = source.reads.single()
+            val expected = File(directory, "${read.id}.chr").readBytes()
+            assertTrue(expected.size > 32768)
+            val first = source.readChunk(read.id, 0, 32768)
+            val last = source.readChunk(read.id, 32768, expected.size - 32768)
+            assertArrayEquals(expected, first + last)
+            assertEquals(expected.size, read.byteCount)
+            assertEquals(MessageDigest.getInstance("SHA-256").digest(expected).joinToString("") { "%02x".format(it.toInt() and 255) }, read.sha256)
+            first.fill(0)
+            assertArrayEquals(expected.copyOfRange(0, 32768), source.readChunk(read.id, 0, 32768))
+            assertTrue(read.closed)
+            assertFalse(read.corrupt)
+            assertEquals("ComboRetainedHistory(redacted)", source.toString())
+            assertEquals("RetainedPumpHistoryRead(redacted)", read.toString())
+            assertThrows(UnsupportedOperationException::class.java) { (source.reads as MutableList).clear() }
+            source.close()
+            source.close()
+            refused { source.requireCurrent() }
+            complete(journal)
+            assertEquals(2, open(journal).reads.size)
+        }
+    }
+
+    @Test fun inventoryScopesRetainedEvidenceWithoutHidingUnscopedDamage() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            complete(journal, "b".repeat(64))
+        }
+        File(directory, "10000000-0000-4000-8000-000000000001.chr").writeBytes(byteArrayOf(1, 2))
+        ComboHistoryJournal(directory).use { journal ->
+            val source = open(journal)
+            assertEquals(binding, source.pumpBinding)
+            assertEquals(1, source.reads.size)
+            assertEquals(1, source.unscopedCorruptReads)
+            assertFalse(source.writerFailed)
+        }
+    }
+
+    @Test fun ownerCheckedBeforeSnapshotAndAgainAfterFileIo() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            var calls = 0
+            refused { open(journal) { ++calls < 2 } }
+            assertEquals(2, calls)
+            calls = 0
+            refused { open(journal) { calls++; false } }
+            assertEquals(1, calls)
+        }
+    }
+
+    @Test fun lostOwnerDuringChunkReadLatchesEvenWhenOwnerReturns() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            var calls = 0
+            var allowed = true
+            val source = open(journal) { ++calls; allowed && calls != 4 }
+            val read = source.reads.single()
+            refused { source.readChunk(read.id, 0, read.byteCount) }
+            allowed = true
+            refused { source.readChunk(read.id, 0, read.byteCount) }
+            refused { source.requireCurrent() }
+        }
+    }
+
+    @Test fun cancellationIsNotTurnedIntoAnOrdinaryReadFailure() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            assertThrows(CancellationException::class.java) { open(journal) { throw CancellationException() } }
+            var cancel = false
+            val source = open(journal) { if (cancel) throw CancellationException() else true }
+            cancel = true
+            assertThrows(CancellationException::class.java) { source.requireCurrent() }
+            cancel = false
+            refused { source.requireCurrent() }
+        }
+    }
+
+    @Test fun newWriteAndNewSnapshotInvalidatePreviousReaders() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            val old = open(journal)
+            val current = open(journal)
+            refused { old.requireCurrent() }
+            current.requireCurrent()
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            refused { current.requireCurrent() }
+            refused { open(journal) }
+            journal.record(binding, checkpoint(Phase.END))
+            val next = open(journal)
+            assertEquals(2, next.reads.size)
+            next.requireCurrent()
+            journal.close()
+            refused { next.requireCurrent() }
+        }
+    }
+
+    @Test fun invalidFragmentsAreRejectedBeforeReadingAndReaderRemainsInvalid() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal, large = true)
+            val attempts: List<(RetainedPumpHistory) -> Unit> = listOf(
+                { it.readChunk("missing", 0, 32768) },
+                { it.readChunk(it.reads.single().id, -1, 32768) },
+                { it.readChunk(it.reads.single().id, 1, 32768) },
+                { it.readChunk(it.reads.single().id, 0, 0) },
+                { it.readChunk(it.reads.single().id, 0, 32767) },
+                { it.readChunk(it.reads.single().id, 0, 32769) },
+                { it.readChunk(it.reads.single().id, it.reads.single().byteCount, 0) },
+                { it.readChunk(it.reads.single().id, Int.MAX_VALUE, Int.MAX_VALUE) }
+            )
+            attempts.forEach { attempt ->
+                val source = open(journal)
+                refused { attempt(source) }
+                refused { source.requireCurrent() }
+                assertEquals(1, open(journal).reads.size)
+            }
+        }
+    }
+
+    @Test fun changedFileCannotReturnBytesFromAnOldInventory() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal)
+            val source = open(journal)
+            val read = source.reads.single()
+            RandomAccessFile(File(directory, "${read.id}.chr"), "rw").use { it.seek(10); it.write(1) }
+            refused { source.readChunk(read.id, 0, read.byteCount) }
+            refused { source.requireCurrent() }
+        }
+    }
+
+    @Test fun interruptedAndFailedEvidenceIsNotReportedAsComplete() {
+        ComboHistoryJournal(directory).use { it.record(binding, checkpoint(Phase.BEGIN)) }
+        ComboHistoryJournal(directory).use { journal ->
+            val source = open(journal)
+            assertFalse(source.reads.single().closed)
+            assertFalse(source.writerFailed)
+        }
+        ComboHistoryJournal(directory, sync = { throw java.io.IOException("synthetic") }).use { journal ->
+            assertThrows(java.io.IOException::class.java) { journal.record(binding, checkpoint(Phase.BEGIN)) }
+            val source = open(journal)
+            assertTrue(source.writerFailed)
+            assertTrue(source.reads.any { !it.closed })
+        }
+    }
+}
