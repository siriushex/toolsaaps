+            assertEquals("History snapshot unavailable", error.message)
+            assertNull(error.cause)
+            fail = false
+            val snapshot = journal.snapshot(binding)
+            fail = true
+            assertThrows(IOException::class.java) { journal.readChunk(snapshot, snapshot.reads.single().id, 0, 32) }
+            fail = false
+            assertEquals(1, journal.snapshot(binding).reads.size)
+            complete(journal)
+        }
+    }
+}
