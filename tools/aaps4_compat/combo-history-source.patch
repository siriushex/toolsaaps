+package app.aaps.core.interfaces.pump
+
+/** Optional local evidence reader. Not a pump command or a proof of insulin delivery. */
+interface RetainedPumpHistorySource {
+
+    /** Blocking private-file I/O. Call off the main thread and outside therapy-command locks. */
+    fun openRetainedHistory(): RetainedPumpHistory
+}
+
+/** One immutable inventory; a write, replacement snapshot or lost owner invalidates its reader. */
+interface RetainedPumpHistory {
+
+    val pumpBinding: String
+    val reads: List<RetainedPumpHistoryRead>
+    val unscopedCorruptReads: Int
+    val writerFailed: Boolean
+
+    /** Recheck before publishing an inventory or bytes, including after suspended work. */
+    fun requireCurrent()
+
+    /** Exactly one aligned 32 KiB fragment, except the final shorter fragment. Caller owns bytes. */
+    fun readChunk(readId: String, offset: Int, byteCount: Int): ByteArray
+
+    /** Invalidates only this reader, never the pump's journal writer. */
+    fun close()
+}
+
+class RetainedPumpHistoryRead(
+    val id: String,
+    val byteCount: Int,
+    val sha256: String,
+    val closed: Boolean,
+    val corrupt: Boolean,
+    val adverse: Boolean,
+    val readFailed: Boolean
+) {
+    override fun toString() = "RetainedPumpHistoryRead(redacted)"
+}
+
+class RetainedPumpHistoryUnavailable : IllegalStateException("Retained pump history unavailable")
