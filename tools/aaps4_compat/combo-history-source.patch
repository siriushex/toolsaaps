+            val latest = journal.snapshot(binding)
+            assertThrows(IOException::class.java) { journal.readChunk(old, old.reads.single().id, 0, 32) }
+            journal.requireCurrent(latest)
+            assertEquals(32, journal.readChunk(latest, latest.reads.single().id, 0, 32).bytes().size)
+        }
+    }
+
+    @Test fun inheritedWriterMonitorIsRefusedBeforeAnyArchiveIo() {
+        var reads = 0
+        ComboHistoryJournal(File(root, "history"), beforeRead = { reads++ }).use { journal ->
+            complete(journal)
+            val snapshot = journal.snapshot(binding)
+            val before = reads
+            synchronized(journal) {
+                assertThrows(IOException::class.java) { journal.snapshot(binding) }
