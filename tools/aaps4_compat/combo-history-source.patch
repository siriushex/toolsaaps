+class ComboHistoryReadConcurrencyTest {
+    @TempDir lateinit var root: File
+    private val binding = "a".repeat(64)
+
+    private class Pause {
+        val armed = AtomicBoolean(false)
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+
+        fun beforeRead() {
+            if (armed.compareAndSet(true, false)) {
+                entered.countDown()
+                check(release.await(30, SECONDS))
+            }
+        }
+    }
+
+    private fun complete(journal: ComboHistoryJournal) {
+        for (phase in listOf(Phase.BEGIN, Phase.END)) journal.record(binding, HistoryReadCheckpoint(
+            phase, HistoryReadObservation(state = if (phase == Phase.END)
+                HistoryReadObservation.State.RETURNED else HistoryReadObservation.State.READING)
+        ))
+    }
+
+    private fun stale(future: Future<*>) {
+        val error = assertThrows(ExecutionException::class.java) { future.get(5, SECONDS) }
+        assertInstanceOf(IOException::class.java, error.cause)
+        assertNull(error.cause!!.cause)
+    }
+
+    private fun concurrent(block: (ComboHistoryJournal, Pause, java.util.concurrent.ExecutorService) -> Unit) {
+        val pause = Pause()
+        val executor = Executors.newFixedThreadPool(3)
+        val journal = ComboHistoryJournal(File(root, "history"), beforeRead = pause::beforeRead)
+        try {
+            complete(journal)
+            block(journal, pause, executor)
+        } finally {
+            pause.release.countDown()
+            executor.shutdown()
+            try { assertTrue(executor.awaitTermination(10, SECONDS)) } finally { journal.close() }
+        }
+    }
+
+    @Test fun slowSnapshotDoesNotBlockCheckpointsAndCannotCommitAfterAWrite() = concurrent { journal, pause, executor ->
+        pause.armed.set(true)
+        val reader = executor.submit<ComboHistoryJournal.Snapshot> { journal.snapshot(binding) }
+        assertTrue(pause.entered.await(5, SECONDS))
+        executor.submit { complete(journal) }.get(5, SECONDS)
+        pause.release.countDown()
+        stale(reader)
+        assertEquals(2, journal.snapshot(binding).reads.size)
+    }
+
+    @Test fun slowChunkDoesNotBlockCheckpointsAndCannotReturnAfterAWrite() = concurrent { journal, pause, executor ->
+        val snapshot = journal.snapshot(binding)
+        pause.armed.set(true)
+        val reader = executor.submit<ComboHistoryJournal.Chunk> { journal.readChunk(snapshot, snapshot.reads.single().id, 0, 32) }
+        assertTrue(pause.entered.await(5, SECONDS))
+        executor.submit { complete(journal) }.get(5, SECONDS)
+        pause.release.countDown()
+        stale(reader)
+        assertEquals(2, journal.snapshot(binding).reads.size)
+    }
+
+    @Test fun busyArchiveReadFailsFastWithoutInvalidatingTheCurrentReader() = concurrent { journal, pause, executor ->
+        val snapshot = journal.snapshot(binding)
+        val id = snapshot.reads.single().id
+        pause.armed.set(true)
+        val reader = executor.submit<ComboHistoryJournal.Chunk> { journal.readChunk(snapshot, id, 0, 32) }
+        assertTrue(pause.entered.await(5, SECONDS))
+        executor.submit {
+            assertThrows(IOException::class.java) { journal.snapshot(binding) }
+            assertThrows(IOException::class.java) { journal.readChunk(snapshot, id, 0, 32) }
+            journal.requireCurrent(snapshot)
+        }.get(5, SECONDS)
+        pause.release.countDown()
+        assertEquals(32, reader.get(5, SECONDS).bytes().size)
+        journal.requireCurrent(snapshot)
+        assertEquals(1, journal.snapshot(binding).reads.size)
+    }
+
+    @Test fun closeDoesNotWaitForSnapshotIoOrPermitOldResultToRevive() = concurrent { journal, pause, executor ->
+        pause.armed.set(true)
+        val reader = executor.submit<ComboHistoryJournal.Snapshot> { journal.snapshot(binding) }
+        assertTrue(pause.entered.await(5, SECONDS))
+        executor.submit { journal.close() }.get(5, SECONDS)
+        pause.release.countDown()
+        stale(reader)
+        assertThrows(IOException::class.java) { journal.snapshot(binding) }
+    }
+
+    @Test fun closeDoesNotWaitForChunkIoOrPermitOldBytesToReturn() = concurrent { journal, pause, executor ->
+        val snapshot = journal.snapshot(binding)
+        pause.armed.set(true)
+        val reader = executor.submit<ComboHistoryJournal.Chunk> { journal.readChunk(snapshot, snapshot.reads.single().id, 0, 32) }
+        assertTrue(pause.entered.await(5, SECONDS))
+        executor.submit { journal.close() }.get(5, SECONDS)
+        pause.release.countDown()
+        stale(reader)
+    }
+
+    @Test fun facadeCloseDoesNotWaitForChunkIoOrCloseThePumpWriter() = concurrent { journal, pause, executor ->
+        val source = ComboRetainedHistory.open(journal, binding) { true }
+        val read = source.reads.single()
+        pause.armed.set(true)
+        val reader = executor.submit<ByteArray> { source.readChunk(read.id, 0, read.byteCount) }
