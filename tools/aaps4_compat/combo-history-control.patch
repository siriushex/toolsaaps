+    // Read-history replies must not share the target/delivery ACK slot.
+    private val historyType = "combo_history_read_v1"
+    private fun historyAckId(clientId: String) = "${ClientControlPublisher.IDENTIFIER_ACK_PREFIX}history_$clientId"
+
+    private suspend fun captureHistoryAcks(clientId: String): MutableList<AckEnvelope> {
+        val acks = mutableListOf<AckEnvelope>()
+        whenever(nsAndroidClient.updateSettings(eq(historyAckId(clientId)), any())).thenAnswer {
+            acks += Json.decodeFromJsonElement(AckEnvelope.serializer(), it.getArgument<JsonObject>(1).getValue("ack"))
+            deleteOk
+        }
+        return acks
+    }
+
+    private fun historyEnvelope(clientId: String, secret: ByteArray, payload: String = "{}",
+                                type: String = historyType, until: Long = now + 30_000L,
+                                wantsAck: Boolean = true): SignedEnvelope =
+        signedEnvelope(clientId, secret, type, payload, counter = 5L, validUntil = until, wantsAck = wantsAck)
+
+    private fun assertHistoryFailure(acks: List<AckEnvelope>, secret: ByteArray, status: String = "Failed") {
+        assertThat(acks).hasSize(1)
+        assertThat(acks.single().phase.name).isEqualTo("Done")
+        assertThat(acks.single().status.name).isEqualTo(status)
+        assertThat(acks.single().payload).isNull()
+        assertThat(ClientControlCrypto.verifyAck(secret, acks.single())).isTrue()
+    }
+
+    @Test fun unsupportedHistoryReplyIsSignedAndDoesNotReplaceTherapyAck() = runTest {
+        val (clientId, secret) = pair()
+        authorizedRepository.markActive(clientId, 1L, now)
+        val ordinary = captureAcks(clientId)
+        val history = captureHistoryAcks(clientId)
+        sut.onSettingsDocChanged("${ClientControlPublisher.IDENTIFIER_CMD_PREFIX}ping_$clientId",
+            wrap(envelope(clientId, secret, ClientControlMessage.Ping, counter = 3L, wantsAck = true)))
+        val previous = ordinary.toList()
+        val request = historyEnvelope(clientId, secret, """{"type":"combo_history_read_v1","version":1,"query":{"kind":"inventory","limit":1}}""")
+        sut.onSettingsDocChanged("${ClientControlPublisher.IDENTIFIER_CMD_PREFIX}${historyType}_$clientId", wrap(request))
+        assertHistoryFailure(history, secret)
+        assertThat(ordinary).containsExactlyElementsIn(previous).inOrder()
+        assertThat(authorizedRepository.findRaw(clientId)!!.counterReceived).isEqualTo(5L)
+        verifyNoInteractions(wizardBolusExecutor, sceneAutomationApi, commandQueue, notificationManager, persistenceLayer)
+    }
+
+    @Test fun expiredHistoryUsesOnlyHistoryReplySlot() = runTest {
