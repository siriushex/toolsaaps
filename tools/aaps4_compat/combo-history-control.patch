+        val history = captureHistoryAcks(clientId)
+        val payload = publisherJson.encodeToString(ClientControlMessage.serializer(), message)
+        sut.onSettingsDocChanged("${ClientControlPublisher.IDENTIFIER_CMD_PREFIX}read",
+            wrap(historyEnvelope(clientId, secret, payload, type)))
+        assertThat(authorizedRepository.findRaw(clientId)!!.state).isEqualTo(if (active) ClientState.Active else ClientState.Pending)
+        verifyNoInteractions(wizardBolusExecutor, sceneAutomationApi, commandQueue, notificationManager, persistenceLayer)
+        verify(runningConfigurationPublisher, never()).requestColdRepublish()
+        verify(offerPublisher, never()).deleteOffer(any())
+        assertHistoryFailure(history, secret)
+        assertThat(ordinary).isEmpty()
+    }
