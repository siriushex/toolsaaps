+package app.aaps.core.nssdk.utils
+
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/** A signed receipt for this enrollment, not a command grant or a global roster. */
+object LocalEnrollmentRole {
+    fun identifier(clientId: String) = "local_enrollment_role_v1_" + clientId
+
+    fun body(clientId: String, masterId: String, handle: String, role: String,
+             counter: Long, signedAt: Long, expiresAt: Long): String = buildJsonObject {
+        put("clientId", clientId); put("masterInstallId", masterId); put("handle", handle)
+        put("role", role); put("counter", counter); put("signedAt", signedAt); put("expiresAt", expiresAt)
+        put("controlEnabled", true)
+    }.toString()
+}
