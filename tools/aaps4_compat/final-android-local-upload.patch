+++ b/app/src/main/kotlin/app/aaps/localobservation/LocalObservationSnapshot.kt
@@ -0,0 +1,104 @@
+package app.aaps.localobservation
+
+import app.aaps.core.data.model.ICfg
+import app.aaps.core.data.model.IDs
+import app.aaps.core.data.model.BS
+import app.aaps.core.interfaces.db.PersistenceLayer
+import app.aaps.core.interfaces.utils.DateUtil
+import app.aaps.core.objects.profile.ProfileSealed
+import kotlinx.serialization.json.JsonObjectBuilder
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+internal suspend fun readLocalObservation(db: PersistenceLayer, dateUtil: DateUtil, now: Long): ByteArray {
+    val from = now - 86_400_000L
+    val samples = db.getBgReadingsDataFromTimeToTime(now - 30 * 60_000L, now, false)
+    val profile = db.getEffectiveProfileSwitchActiveAt(now)
+    val boluses = db.getBolusesFromTimeToTime(from, now, true).filter { it.type != BS.Type.PRIMING && it.amount > 0 }
+    val basals = db.getTemporaryBasalsStartingFromTimeToTime(from, now, true)
+    val extended = db.getExtendedBolusesStartingFromTimeToTime(from, now, true)
+    val count = boluses.size + basals.size + extended.size
+    check(samples.size <= 256 && count <= 512)
+    return buildJsonObject {
+        put("version", 1)
+        put("at", now)
+        put("glucose", buildJsonArray {
+            samples.filter { it.isValid }.forEach { sample ->
+                add(buildJsonObject {
+                    put("date", sample.timestamp)
+                    put("sgv", sample.value)
+                    put("sensor", sample.sourceSensor.name)
+                })
+            }
+        })
+        if (profile != null && profile.isValid) {
+            put("profile", buildJsonObject {
+                put("date", profile.timestamp)
+                put("utcOffset", profile.utcOffset / 60_000L)
+                put("eventType", "Note")
+                put("originalProfileName", profile.originalProfileName)
+                put("originalCustomizedName", profile.originalCustomizedName)
+                put("originalTimeshift", profile.originalTimeshift)
+                put("originalPercentage", profile.originalPercentage)
+                put("originalDuration", profile.originalDuration)
+                put("originalEnd", profile.originalEnd)
+                put("profileJson", ProfileSealed.EPS(profile, null).toPureNsJson(dateUtil).toString())
+                put("icfg", profile.iCfg.observationJson())
+            })
+        }
+        put("insulin", buildJsonArray {
+            boluses.filter { it.isValid }.forEach { bolus ->
+                add(buildJsonObject {
+                    put("eventType", "Correction Bolus")
+                    put("date", bolus.timestamp)
+                    put("utcOffset", bolus.utcOffset / 60_000L)
+                    put("insulin", bolus.amount)
+                    put("type", bolus.type.name)
+                    put("isBasalInsulin", bolus.isBasalInsulin)
+                    put("icfg", bolus.iCfg.observationJson())
+                    pumpIdentity(bolus.ids)
+                })
+            }
+            basals.filter { it.isValid }.forEach { basal ->
+                add(buildJsonObject {
+                    put("eventType", "Temp Basal")
+                    put("date", basal.timestamp)
+                    put("utcOffset", basal.utcOffset / 60_000L)
+                    put("durationInMilliseconds", basal.duration)
+                    put("type", basal.type.name)
+                    if (basal.isAbsolute) put("absolute", basal.rate) else put("percent", basal.rate - 100)
+                    pumpIdentity(basal.ids)
+                })
+            }
+            extended.filter { it.isValid }.forEach { bolus ->
+                add(buildJsonObject {
+                    put("eventType", "Combo Bolus")
+                    put("date", bolus.timestamp)
+                    put("utcOffset", bolus.utcOffset / 60_000L)
+                    put("durationInMilliseconds", bolus.duration)
+                    put("enteredinsulin", bolus.amount)
+                    put("isEmulatingTempBasal", bolus.isEmulatingTempBasal)
+                    pumpIdentity(bolus.ids)
+                })
+            }
+        })
+    }.toString().encodeToByteArray().also { check(it.size <= 196_608) }
+}
+
+private fun ICfg.observationJson() = buildJsonObject {
+    put("insulinLabel", insulinLabel)
+    put("insulinEndTime", insulinEndTime)
+    put("insulinPeakTime", insulinPeakTime)
+    put("concentration", concentration)
+}
+
+private fun JsonObjectBuilder.pumpIdentity(ids: IDs) {
+    val id = ids.pumpId ?: return
+    val type = ids.pumpType ?: return
+    val serial = ids.pumpSerial?.takeIf { it.isNotBlank() } ?: return
+    put("pumpId", id)
+    put("pumpType", type.name)
+    put("pumpSerial", serial)
+    ids.endId?.let { put("endId", it) }
+}
diff --git a/app/src/main/kotlin/app/aaps/localobservation/LocalObservationUpload.kt b/app/src/main/kotlin/app/aaps/localobservation/LocalObservationUpload.kt
new file mode 100644
index 0000000000000000000000000000000000000000..9371069522d4d7a2312f2c5206b1ddd346100264
--- /dev/null
+++ b/app/src/main/kotlin/app/aaps/localobservation/LocalObservationUpload.kt
@@ -0,0 +1,82 @@
+package app.aaps.localobservation
+
+import android.os.Bundle
+import app.aaps.core.nssdk.networking.NsLocalObservationUpload
+import app.aaps.core.nssdk.networking.NsLoopbackUploadIdentity
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import java.security.MessageDigest
+
+internal class LocalObservationUpload {
+    private val acknowledged = LinkedHashSet<String>()
+    private var destination: String? = null
+
+    // The provider holds its non-queuing lease for this entire call.
+    suspend fun run(ticket: Bundle, snapshot: ByteArray): Boolean {
+        val port = ticket.getInt("port")
+        val root = checkNotNull(ticket.getByteArray("root"))
+        val leaf = checkNotNull(ticket.getByteArray("leaf"))
+        val bearer = checkNotNull(ticket.getString("bearer"))
+        val peer = "$port:${digest(leaf)}"
+        if (destination != peer) {
+            acknowledged.clear()
+            destination = peer
+        }
+        val entries = records(snapshot)
+        val pending = entries.map { it to digest(it.body.toString().encodeToByteArray()) }
+            .filterNot { (_, key) -> key in acknowledged }
+        val client = NsLocalObservationUpload(port, NsLoopbackUploadIdentity(root, leaf), bearer)
+        try {
+            if (!client.ready()) return false
+            var rejected = false
+            pending.take(MAX_PER_CYCLE).forEach { (row, key) ->
+                if (client.store(row.glucose, row.body)) {
+                    if (acknowledged.size >= MAX_ACKNOWLEDGED) acknowledged.remove(acknowledged.first())
+                    acknowledged.add(key)
+                } else {
+                    rejected = true
+                }
+            }
+            return !rejected && pending.size <= MAX_PER_CYCLE
+        } finally {
+            client.close()
+        }
+    }
+
+    companion object {
+        private const val MAX_PER_CYCLE = 64
+        private const val MAX_ACKNOWLEDGED = 2_048
+
+        internal data class Row(val glucose: Boolean, val body: JsonObject)
+
+        internal fun records(snapshot: ByteArray): List<Row> {
+            val json = Json.parseToJsonElement(snapshot.decodeToString()).jsonObject
+            return buildList {
+                val glucose = json.getValue("glucose").jsonArray.map { it.jsonObject }
+                    .sortedByDescending { it.getValue("date").toString().toLong() }
+                fun addGlucose(sample: JsonObject) {
+                    val values = sample - "sensor" + mapOf(
+                        "type" to JsonPrimitive("sgv"), "units" to JsonPrimitive("mg/dl"),
+                        "device" to sample.getValue("sensor"), "app" to JsonPrimitive("AAPS-local")
+                    )
+                    add(Row(true, JsonObject(values)))
+                }
+                glucose.firstOrNull()?.let(::addGlucose)
+                json["profile"]?.let { add(Row(false, withSource(it.jsonObject))) }
+                val insulin = json.getValue("insulin").jsonArray.map { it.jsonObject }
+                    .sortedByDescending { it.getValue("date").toString().toLong() }
+                insulin.firstOrNull()?.let { add(Row(false, withSource(it))) }
+                glucose.drop(1).forEach(::addGlucose)
+                insulin.drop(1).forEach { add(Row(false, withSource(it))) }
+            }
+        }
+
+        private fun withSource(body: JsonObject) = JsonObject(body + ("app" to JsonPrimitive("AAPS-local")))
+
+        private fun digest(bytes: ByteArray): String = MessageDigest.getInstance("SHA-256")
+            .digest(bytes).joinToString("") { "%02x".format(it) }
+    }
+}
