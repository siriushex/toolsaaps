+package app.aaps.plugins.sync.nsclientV3.localpin
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.ClientControlMessage
+import app.aaps.core.nssdk.localmodel.clientcontrol.KeyExchangeEnvelope
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingPayload
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import app.aaps.core.nssdk.utils.ClientControlCrypto
+import app.aaps.core.nssdk.utils.ClientControlKeyExchangeCrypto
+import kotlinx.serialization.json.Json
+
+/** Only used from the pinned subscriber. No fallback to a Nightscout subject or owner token. */
+internal object LocalPinKeyResponder {
+    suspend fun answer(pending: PairingPayload, hello: SignedEnvelope, issue: suspend (String) -> ByteArray?,
+                       storePending: suspend (SignedEnvelope, ByteArray) -> Boolean): KeyExchangeEnvelope? {
+        val old = ClientControlCrypto.hexToBytes(pending.secretHex)
+        try {
+            fun current() = System.currentTimeMillis() in hello.timestamp until pending.expiresAt
+            if (!current() || hello.clientId != pending.clientId || hello.validUntil != pending.expiresAt ||
+                hello.counter != 1L || hello.type != "hello" || hello.wantsAck || !ClientControlCrypto.verifyEnvelope(old, hello)) return null
+            val payload = Json.decodeFromString(ClientControlMessage.serializer(), hello.payload) as? ClientControlMessage.Hello ?: return null
+            val point = payload.publicKey?.takeIf { payload.protocolVersion == 1 && it.length == 88 } ?: return null
+            val master = ClientControlKeyExchangeCrypto.newKeyPair()
+            val keys = try {
+                ClientControlKeyExchangeCrypto.deriveKeys(master.privateKey, point, old, pending.clientId, point, master.publicKey)
+            } finally { master.privateKey.fill(0) }
+            try {
+                val token = issue(point) ?: return null
+                val encrypted = try {
+                    val value = token.decodeToString()
+                    if (token.size != 43 || !value.matches(Regex("[A-Za-z0-9_-]{43}"))) return null
+                    ClientControlKeyExchangeCrypto.encryptToken(keys.tokenKey, value)
+                } finally { token.fill(0) }
+                if (!current() || !storePending(hello, keys.secret) || !current()) return null
+                return ClientControlCrypto.signKeyExchange(old, KeyExchangeEnvelope(clientId = pending.clientId,
+                    clientPublicKey = point, masterPublicKey = master.publicKey, tokenIv = encrypted.first,
+                    token = encrypted.second, timestamp = System.currentTimeMillis(), signature = ""))
+            } finally { keys.secret.fill(0); keys.tokenKey.fill(0) }
+        } finally { old.fill(0) }
+    }
+}
