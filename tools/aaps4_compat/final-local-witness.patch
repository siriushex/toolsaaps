+    /** One same-phone membership check, including after PIN expiry. No command, role or counter mutation. */
+    suspend fun localSessionWitness(request: SignedEnvelope, master: String, nonce: String, signer: MasterSigningKey,
+                                    clock: () -> Long): MasterSigningKey.Signed? = mutex.withLock {
+        fun live() = preferences.hardenedMode && preferences.get(StringNonKey.NsClientControlOwnInstallId) == master &&
+            LocalSessionWitness.accepts(request, master, nonce, clock())
+        if (!live()) return@withLock null
+        val entry = decode().singleOrNull { it.clientId == request.clientId } ?: return@withLock null
+        val role = ClientRole.entries.singleOrNull { it.name == entry.role } ?: return@withLock null
+        if (!entry.localCopilot || entry.state != ClientState.Active || entry.counterReceived < 2L ||
+            entry.pendingSecret != null || request.timestamp < entry.lastSeenAt ||
+            !secureEncrypt.isValidDataString(entry.encryptedSecret)) return@withLock null
+        val key = ClientControlCrypto.hexToBytes(secureEncrypt.decrypt(entry.encryptedSecret))
+        val authentic = try { key.size == 32 && ClientControlCrypto.verifyEnvelope(key, request) } finally { key.fill(0) }
+        if (!authentic || !live()) return@withLock null
+        var signedAt = 0L
+        val result = signer.sign(LocalSessionWitness.identifier(entry.clientId)) { at ->
+            signedAt = at
+            LocalSessionWitness.signedBody(request, master, nonce, role.name, at)
+        }
+        result.takeIf { it.signature != null && live() && signedAt in request.timestamp..clock() && signedAt < request.validUntil }
+    }
