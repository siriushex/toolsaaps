+package app.aaps.localsession
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.content.pm.PackageManager
+import android.database.Cursor
+import android.net.Uri
+import android.os.Binder
+import android.os.Bundle
+import android.os.Process
+import android.os.SystemClock
+import app.aaps.MainApp
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Same-signature, single-peer, proof of current membership only. No settings or therapy operations. */
+class LocalSessionProvider : ContentProvider() {
+    private val busy = AtomicBoolean(false)
+    private var lastAttempt = -5_000L
+    override fun onCreate() = true
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        val app = checkNotNull(context).applicationContext as MainApp
+        val uid = Binder.getCallingUid()
+        if (app.packageName != "info.nightscout.androidaps" || callingPackage != PEER ||
+            app.packageManager.getPackagesForUid(uid)?.singleOrNull() != PEER ||
+            app.checkCallingPermission(app.packageName + ".permission.CHECK_LOCAL_CLIENT_SESSION") != PackageManager.PERMISSION_GRANTED ||
+            app.packageManager.checkSignatures(uid, Process.myUid()) != PackageManager.SIGNATURE_MATCH) throw SecurityException("denied")
+        require(method == "witness_v1" && arg == null && extras != null && extras.keySet() == setOf("master", "nonce", "request"))
+        val master = extras.getString("master")?.takeIf { it.length in 1..128 } ?: return Bundle()
+        val nonce = extras.getString("nonce")?.takeIf { it.length == 36 } ?: return Bundle()
+        val bytes = extras.getByteArray("request")?.takeIf { it.size in 1..2048 } ?: return Bundle()
+        if (!busy.compareAndSet(false, true)) return Bundle()
+        try {
+            val elapsed = SystemClock.elapsedRealtime()
+            if (elapsed - lastAttempt < 5_000L) return Bundle()
+            lastAttempt = elapsed
+            val token = Binder.clearCallingIdentity()
+            try {
+                val request = Json.decodeFromString(SignedEnvelope.serializer(), bytes.decodeToString(throwOnInvalidSequence = true))
+                val witness = runBlocking(Dispatchers.IO) {
+                    withTimeoutOrNull(2500) { app.localSessionWitness(request, master, nonce) }
+                } ?: return Bundle()
+                val reply = buildJsonObject { put("signed", witness.text); put("signature", witness.signature) }
+                return Bundle().apply { putByteArray("witness", reply.toString().encodeToByteArray()) }
+            } catch (_: Exception) { return Bundle() } finally { Binder.restoreCallingIdentity(token) }
+        } finally { bytes.fill(0); busy.set(false) }
+    }
+    override fun getType(uri: Uri): String? = null
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?, args: Array<out String>?, sort: String?): Cursor? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = throw UnsupportedOperationException()
+    override fun delete(uri: Uri, selection: String?, args: Array<out String>?): Int = throw UnsupportedOperationException()
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, args: Array<out String>?): Int = throw UnsupportedOperationException()
+    private companion object { const val PEER = "io.aaps.predictivecopilot" }
+}
