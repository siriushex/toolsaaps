+package app.aaps.core.nssdk.utils
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/** Read-only reconnect proof. It has its own domain and never occupies a command counter. */
+object LocalSessionWitness {
+    private val id = Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+    private val masterId = Regex("[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}")
+    fun identifier(client: String) = "local_session_witness_v1_" + client
+
+    fun accepts(request: SignedEnvelope, master: String, nonce: String, now: Long): Boolean =
+        id.matches(request.clientId) && masterId.matches(master) && id.matches(nonce) &&
+            request.type == "local_session_witness_v1" && request.counter == 0L && request.wantsAck &&
+            request.timestamp in 1..(Long.MAX_VALUE - 8_000L) && request.validUntil == request.timestamp + 8_000L &&
+            now in request.timestamp until request.validUntil && request.payload == buildJsonObject {
+                put("masterInstallId", master); put("nonce", nonce)
+            }.toString()
+
+    fun signedBody(request: SignedEnvelope, master: String, nonce: String, role: String, signedAt: Long) =
+        buildJsonObject {
+            put("clientId", request.clientId); put("masterInstallId", master); put("nonce", nonce)
+            put("role", role); put("issued", request.timestamp); put("expiresAt", request.validUntil); put("signedAt", signedAt)
+        }.toString()
+}
