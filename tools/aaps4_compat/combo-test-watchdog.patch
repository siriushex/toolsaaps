+package info.nightscout.comboctl.base.testUtils
+
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertTrue
+
+class WatchdogTest {
+    @Test fun blockingWatchdogRemainsArmedForChildrenAfterBodyReturns() {
+        var childCancelled = false
+        val error = assertFailsWith<AssertionError> {
+            runBlockingWithWatchdog(50) {
+                launch {
+                    try { delay(250) } finally { childCancelled = true }
+                }
+            }
+        }
+        assertEquals("Test run timeout reached", error.message)
+        assertTrue(childCancelled)
+    }
+
+    @Test fun suspendingWatchdogRemainsArmedForChildrenAfterBodyReturns() = runBlocking {
+        var childCancelled = false
+        assertFailsWith<WatchdogTimeoutException> {
+            coroutineScopeWithWatchdog(50) {
+                launch {
+                    try { delay(250) } finally { childCancelled = true }
+                }
+            }
+        }
+        assertTrue(childCancelled)
+    }
+
+    @Test fun blockingWatchdogWaitsForSuccessfulChildren() {
+        var completed = false
+        runBlockingWithWatchdog(5000) {
+            launch { delay(1); completed = true }
+        }
+        assertTrue(completed)
+    }
+
+    @Test fun suspendingWatchdogWaitsForSuccessfulChildren() = runBlocking {
+        var completed = false
+        coroutineScopeWithWatchdog(5000) {
+            launch { delay(1); completed = true }
+        }
+        assertTrue(completed)
+    }
+
+    @Test fun originalFailureIsNotReplacedByTimeout() {
+        val error = assertFailsWith<IllegalArgumentException> {
+            runBlockingWithWatchdog(5000) { throw IllegalArgumentException("synthetic failure") }
+        }
+        assertEquals("synthetic failure", error.message)
+    }
+
+    @Test fun suspendingOriginalFailureIsNotReplacedByTimeout() = runBlocking {
+        val error = assertFailsWith<IllegalArgumentException> {
+            coroutineScopeWithWatchdog(5000) { throw IllegalArgumentException("synthetic failure") }
+        }
+        assertEquals("synthetic failure", error.message)
+    }
+}
