+package app.aaps.core.nssdk.networking
+
+import kotlinx.serialization.json.JsonObject
+
+class NsLocalObservationUpload(port: Int, identity: NsLoopbackUploadIdentity, bearer: String) {
+    private val stack = NsKtorClient.stack(
+        baseUrl = "https://127.0.0.1:$port/api/", refreshToken = "", logging = false,
+        logger = {}, loopbackUpload = identity,
+        uploadBearer = bearer.also { require(Regex("[A-Za-z0-9_-]{43}").matches(it)) }
+    )
+
+    suspend fun ready(): Boolean {
+        val response = stack.api.statusSimple()
+        val status = if (response.code == 200) response.body()?.result else null
+        return status?.apiVersion == "3.0.0"
+    }
+
+    suspend fun store(glucose: Boolean, record: JsonObject): Boolean {
+        val response = stack.api.createLocalUpload(if (glucose) "entries" else "treatments", record)
+        return response.code in setOf(200, 201) && !response.body()?.identifier.isNullOrBlank()
+    }
+
+    fun close() = stack.close()
+}
