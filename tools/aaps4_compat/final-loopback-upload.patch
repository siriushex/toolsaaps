@@ -0,0 +1,145 @@
+package app.aaps.core.nssdk.networking
+
+import app.aaps.core.nssdk.NSAndroidClientImpl
+import app.aaps.core.nssdk.localmodel.treatment.EventType
+import app.aaps.core.nssdk.remotemodel.RemoteEntry
+import app.aaps.core.nssdk.remotemodel.RemoteTreatment
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.tls.HandshakeCertificates
+import okhttp3.tls.HeldCertificate
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.net.InetAddress
+import java.net.ProtocolException
+import java.util.concurrent.TimeUnit
+import javax.net.ssl.SSLHandshakeException
+import javax.net.ssl.SSLPeerUnverifiedException
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+class NsLoopbackUploadTransportTest {
+    private val ca = HeldCertificate.Builder().certificateAuthority(0).build()
+    private val leaf = serverLeaf(ca)
+    private val identity = NsLoopbackUploadIdentity(ca.certificate.encoded, leaf.certificate.encoded)
+
+    @Test
+    fun `SDK authenticates over pinned TLS without logging and cannot import or dispatch`() {
+        withServer(ca, leaf) { server ->
+            server.enqueue(response(401))
+            server.enqueue(response(200, """{"token":"session-fixture","iat":1700000000,"exp":1700000900}"""))
+            server.enqueue(response(200, """{"result":{"version":"local","apiVersion":"3.0.0","srvDate":1800000000000,
+                "storage":{"storage":"sqlite","version":"1"},"apiPermissions":{"devicestatus":"cr","entries":"crud",
+                "food":"","profile":"cr","settings":"crud","treatments":"crud"}}}"""))
+            server.enqueue(response(200, """{"check":true}"""))
+            server.enqueue(response(200, """{"check":true}"""))
+            repeat(3) { server.enqueue(response(201, """{"identifier":"local-record"}""")) }
+            val log = mutableListOf<String>()
+            val client = client(server, log::add)
+            try {
+                runBlocking {
+                    assertFalse(client.getStatus().apiPermissions.isFull())
+                    assertThrows<ProtocolException> { runBlocking { client.getSgvs() } }
+                    val profile = buildJsonObject { put("date", 1_800_000_000_000L); put("defaultProfile", "Fixture") }
+                    assertThrows<ProtocolException> { runBlocking { client.api.createSetting(profile) } }
+                    assertEquals(201, client.api.createEntry(RemoteEntry(
+                        type = "sgv", date = 1_800_000_000_000L, sgv = 120.0
+                    )).code)
+                    assertEquals(201, client.api.createProfile(profile).code)
+                    assertEquals(201, client.api.createTreatment(RemoteTreatment(
+                        eventType = EventType.MEAL_BOLUS, date = 1_800_000_000_000L, insulin = 1.0
+                    )).code)
+                }
+                val requests = List(8) { checkNotNull(server.takeRequest(1, TimeUnit.SECONDS)).target }
+                assertEquals("/api/v3/status", requests[0])
+                assertEquals("/api/v2/authorization/request/local-fixture", requests[1])
+                assertEquals("/api/v3/status", requests[2])
+                assertEquals(listOf("/api/v3/entries", "/api/v3/profile", "/api/v3/treatments"), requests.takeLast(3))
+                assertEquals(8, server.requestCount)
+                assertEquals(emptyList(), log)
+            } finally {
+                client.close()
+            }
+        }
+    }
+
+    @Test
+    fun `another server leaf under the same CA cannot connect`() {
+        withServer(ca, serverLeaf(ca)) { server ->
+            val client = client(server)
+            try {
+                assertThrows<SSLHandshakeException> { runBlocking { client.api.statusSimple() } }
+                assertEquals(0, server.requestCount)
+            } finally {
+                client.close()
+            }
+        }
+    }
+
+    @Test
+    fun `a pinned leaf does not replace HTTPS hostname verification`() {
+        val wrongHost = serverLeaf(ca, "localhost")
+        val wrongHostIdentity = NsLoopbackUploadIdentity(ca.certificate.encoded, wrongHost.certificate.encoded)
+        withServer(ca, wrongHost) { server ->
+            val client = client(server, enrolledIdentity = wrongHostIdentity)
+            try {
+                assertThrows<SSLPeerUnverifiedException> { runBlocking { client.api.statusSimple() } }
+                assertEquals(0, server.requestCount)
+            } finally {
+                client.close()
+            }
+        }
+    }
+
+    @Test
+    fun `token refresh does not follow redirects to another origin`() {
+        withServer(ca, leaf) { server ->
+            MockWebServer().use { destination ->
+                destination.start()
+                server.enqueue(response(401))
+                server.enqueue(MockResponse.Builder().code(302).addHeader("Location", destination.url("/fixture")).build())
+                val client = client(server)
+                try {
+                    assertEquals(401, runBlocking { client.api.statusSimple().code })
+                    assertEquals(2, server.requestCount)
+                    assertEquals(0, destination.requestCount)
+                } finally {
+                    client.close()
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `reject unsupported origin before creating a client`() {
+        listOf("http://127.0.0.1:17580", "https://localhost:17580", "https://127.0.0.1:65536",
+            "https://127.0.0.1:17580/other", "https://127.0.0.1:17580@example.invalid").forEach { origin ->
+            assertThrows<IllegalArgumentException> {
+                NSAndroidClientImpl(origin, "local-fixture", false, {}, loopbackUpload = identity).close()
+            }
+        }
+    }
+
+    private fun client(
+        server: MockWebServer,
+        logger: (String) -> Unit = {},
+        enrolledIdentity: NsLoopbackUploadIdentity = identity
+    ) = NSAndroidClientImpl("https://127.0.0.1:${server.port}", "local-fixture", true, logger,
+        loopbackUpload = enrolledIdentity)
+
+    private fun serverLeaf(root: HeldCertificate, host: String = "127.0.0.1") =
+        HeldCertificate.Builder().addSubjectAlternativeName(host).signedBy(root).build()
+
+    private fun withServer(root: HeldCertificate, peer: HeldCertificate, block: (MockWebServer) -> Unit) {
+        MockWebServer().use { server ->
+            server.useHttps(HandshakeCertificates.Builder().heldCertificate(peer, root.certificate).build().sslSocketFactory())
+            server.start(InetAddress.getByName("127.0.0.1"), 0)
+            block(server)
+        }
+    }
+
+    private fun response(status: Int, body: String = "{}") = MockResponse.Builder().code(status).body(body).build()
+}
