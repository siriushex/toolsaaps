+++ b/core/nssdk/src/jvmMain/kotlin/app/aaps/core/nssdk/networking/NsLoopbackUploadTransport.kt
@@ -0,0 +1,88 @@
+package app.aaps.core.nssdk.networking
+
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.net.ProtocolException
+import java.net.Proxy
+import java.security.KeyStore
+import java.security.MessageDigest
+import java.security.cert.CertificateException
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import javax.net.ssl.SSLContext
+import javax.net.ssl.TrustManagerFactory
+import javax.net.ssl.X509TrustManager
+
+internal class NsLoopbackUploadTransport(identity: NsLoopbackUploadIdentity, private val port: Int) {
+    private val root = readDer(identity.rootCa)
+    private val leaf = readDer(identity.serverCertificate)
+    private val chainTrust = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm()).run {
+        init(KeyStore.getInstance(KeyStore.getDefaultType()).apply {
+            load(null, null)
+            setCertificateEntry("loopback-root", root)
+        })
+        trustManagers.filterIsInstance<X509TrustManager>().single()
+    }
+    private val trust = object : X509TrustManager {
+        override fun getAcceptedIssuers(): Array<X509Certificate> = arrayOf(root)
+
+        override fun checkClientTrusted(chain: Array<out X509Certificate>, authType: String) {
+            throw CertificateException("Client certificates are not accepted")
+        }
+
+        override fun checkServerTrusted(chain: Array<out X509Certificate>, authType: String) {
+            val peer = chain.firstOrNull() ?: throw CertificateException("Missing local server certificate")
+            if (!MessageDigest.isEqual(leaf.encoded, peer.encoded)) throw CertificateException("Local server certificate changed")
+            root.checkValidity()
+            chainTrust.checkServerTrusted(chain, authType)
+        }
+    }
+    private val ssl = SSLContext.getInstance("TLS").apply { init(null, arrayOf(trust), null) }
+
+    init {
+        require(root.basicConstraints >= 0 && leaf.basicConstraints == -1) { "Expected a root CA and a distinct server leaf" }
+    }
+
+    fun OkHttpClient.Builder.restrictToLoopbackUpload() {
+        sslSocketFactory(ssl.socketFactory, trust)
+        proxy(Proxy.NO_PROXY)
+        followRedirects(false)
+        followSslRedirects(false)
+        retryOnConnectionFailure(false)
+        addInterceptor { chain ->
+            val request = chain.request()
+            if (!permits(request)) throw ProtocolException("Request is not allowed for local upload")
+            chain.proceed(request)
+        }
+    }
+
+    private fun permits(request: Request): Boolean {
+        val url = request.url
+        if (!url.isHttps || url.host != "127.0.0.1" || url.port != port ||
+            url.username.isNotEmpty() || url.password.isNotEmpty() || url.query != null || url.fragment != null
+        ) return false
+        val path = url.encodedPath
+        return when (request.method) {
+            "GET"  -> path == "/api/v3/status" || path in PERMISSION_CHECKS || AUTH_PATH.matches(path)
+            "POST" -> path in UPLOAD_PATHS
+            else   -> false
+        }
+    }
+
+    private companion object {
+        val AUTH_PATH = Regex("/api/v2/authorization/request/[A-Za-z0-9_-]{1,128}")
+        val PERMISSION_CHECKS = setOf(
+            "/api/v2/authorization/debug/check/api:settings:create",
+            "/api/v2/authorization/debug/check/api:settings:update"
+        )
+        val UPLOAD_PATHS = setOf("/api/v3/entries", "/api/v3/profile", "/api/v3/treatments", "/api/v3/devicestatus")
+
+        fun readDer(bytes: ByteArray): X509Certificate {
+            require(bytes.size in 1..8192) { "Invalid local certificate length" }
+            val certificate = CertificateFactory.getInstance("X.509")
+                .generateCertificate(bytes.inputStream()) as X509Certificate
+            require(MessageDigest.isEqual(bytes, certificate.encoded)) { "Expected a single DER certificate" }
+            return certificate
+        }
+    }
+}
diff --git a/core/nssdk/src/jvmTest/kotlin/app/aaps/core/nssdk/networking/NsLoopbackUploadTransportTest.kt b/core/nssdk/src/jvmTest/kotlin/app/aaps/core/nssdk/networking/NsLoopbackUploadTransportTest.kt
