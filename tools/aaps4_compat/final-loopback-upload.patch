@@ -0,0 +1,15 @@
+package app.aaps.core.nssdk.networking
+
+/** Public DER certificates obtained from the explicitly paired local exporter, not from the TLS peer. */
+class NsLoopbackUploadIdentity(rootCa: ByteArray, serverCertificate: ByteArray) {
+    internal val rootCa = rootCa.copyOf()
+    internal val serverCertificate = serverCertificate.copyOf()
+}
+
+internal val loopbackUploadBase = Regex("https://127\\.0\\.0\\.1:([1-9][0-9]{0,4})/api/")
+
+internal fun loopbackUploadPort(baseUrl: String): Int {
+    val port = loopbackUploadBase.matchEntire(baseUrl)?.groupValues?.get(1)?.toInt()
+    require(port != null && port in 1..65535) { "Local upload requires an explicit HTTPS loopback port" }
+    return port
+}
