diff --git a/core/nssdk/src/jvmMain/kotlin/app/aaps/core/nssdk/networking/NsLoopbackUploadTransport.kt b/core/nssdk/src/jvmMain/kotlin/app/aaps/core/nssdk/networking/NsLoopbackUploadTransport.kt
