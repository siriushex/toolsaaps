+package app.aaps.core.nssdk.networking
+
+import okhttp3.Call
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.Closeable
+import java.net.ProtocolException
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Private HTTP transport for a separate Engine.IO polling manager, not a Nightscout REST client. */
+class NsLocalSettingsPolling(identity: NsLoopbackUploadIdentity, private val port: Int) : Call.Factory, Closeable {
+    init { require(port in 1..65535) }
+
+    private val closed = AtomicBoolean()
+    private val client = OkHttpClient.Builder().also { NsPinnedLoopbackTls(identity).configure(it) }
+        .readTimeout(40, TimeUnit.SECONDS)
+        .callTimeout(45, TimeUnit.SECONDS)
+        .addInterceptor { chain ->
+            if (closed.get() || !permits(chain.request())) throw ProtocolException("Local settings polling unavailable")
+            chain.proceed(chain.request())
+        }.build()
+
+    override fun newCall(request: Request): Call = client.newCall(request)
+
+    override fun close() {
+        if (!closed.compareAndSet(false, true)) return
+        client.dispatcher.cancelAll()
+        client.connectionPool.evictAll()
+    }
+
+    private fun permits(request: Request): Boolean {
+        val url = request.url
+        if (!url.isHttps || url.host != "127.0.0.1" || url.port != port || url.encodedPath != "/socket.io/" ||
+            url.username.isNotEmpty() || url.password.isNotEmpty() || url.fragment != null ||
+            request.headers.names().any { it in FORBIDDEN_HEADERS }) return false
+        val query = url.encodedQuery ?: return false
+        if (query.length > 240 || query.any { it !in QUERY_CHARS } ||
+            url.querySize !in 2..5 || url.queryParameterNames.size != url.querySize) return false
+        for (i in 0 until url.querySize) {
+            val value = url.queryParameterValue(i) ?: return false
+            val allowed = when (url.queryParameterName(i)) {
+                "EIO" -> value == "4"
+                "transport" -> value == "polling"
+                "sid" -> SID.matches(value)
+                "t" -> TIMESTAMP.matches(value)
+                "b64" -> value == "1"
+                else -> false
+            }
+            if (!allowed) return false
+        }
+        return url.queryParameter("EIO") != null && url.queryParameter("transport") != null &&
+            (request.method == "GET" || (request.method == "POST" && url.queryParameter("sid") != null))
+    }
+
+    private companion object {
+        val SID = Regex("[A-Za-z0-9_-]{1,128}")
+        val TIMESTAMP = Regex("[A-Za-z0-9._-]{1,48}")
+        val QUERY_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-=&".toSet()
+        val FORBIDDEN_HEADERS = sortedSetOf(String.CASE_INSENSITIVE_ORDER, "Authorization", "Cookie", "Host",
+            "Proxy-Authorization", "api-secret", "Upgrade")
+    }
+}
