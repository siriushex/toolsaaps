+    @Test
+    fun `dedicated polling client handles handshake polls and posts but never calls REST`() {
+        withServer(ca, leaf) { server ->
+            val origin = "https://127.0.0.1:${server.port}"
+            val poll = "/socket.io/?EIO=4&transport=polling"
+            NsLocalSettingsPolling(identity, server.port).use { transport ->
+                for ((method, suffix) in listOf("GET" to "&t=a.1&b64=1", "POST" to "&sid=session_1",
+                    "GET" to "&sid=session_1&t=b-2")) {
+                    server.enqueue(response(200))
+                    val request = Request.Builder().url(origin + poll + suffix)
+                        .method(method, if (method == "POST") "2".toRequestBody() else null).build()
+                    transport.newCall(request).execute().use { assertEquals(200, it.code) }
+                }
+                assertEquals(3, server.requestCount)
+                for (url in listOf(origin + "/api/v3/status", origin + poll + "&EIO=4", origin + poll + "&accessToken=x",
+                    origin + poll + "&sid=", origin + poll + "&sid=%61", origin + poll + "&b64=0",
+                    origin + poll + "#x", origin.replace("127.0.0.1", "localhost") + poll,
+                    origin.replace("https:", "http:") + poll, origin + "/socket.io/?EIO=4&transport=websocket")) {
+                    assertThrows<ProtocolException> { transport.newCall(Request.Builder().url(url).build()).execute().close() }
+                }
+                val handshake = Request.Builder().url(origin + poll)
+                assertThrows<ProtocolException> { transport.newCall(handshake.post("".toRequestBody()).build()).execute().close() }
+                assertThrows<ProtocolException> {
+                    transport.newCall(handshake.get().header("Cookie", "fixture=1").build()).execute().close()
+                }
+                assertEquals(3, server.requestCount)
