+package app.aaps.core.nssdk.utils
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.AckEnvelope
+import app.aaps.core.nssdk.localmodel.clientcontrol.AckPhase
+import app.aaps.core.nssdk.localmodel.clientcontrol.AckStatus
+import app.aaps.core.nssdk.localmodel.clientcontrol.PongPayload
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import kotlinx.serialization.json.Json
+
+/** Only the first liveness probe for this local enrollment, never an action acknowledgement. */
+object LocalFirstPong {
+    fun sign(key: ByteArray, clientId: String, ping: SignedEnvelope, enrolledAt: Long, expiresAt: Long,
+             now: Long, signingPoint: String): AckEnvelope? {
+        if (key.size != 32 || signingPoint.length != 88 || ping.clientId != clientId || ping.counter != 2L ||
+            !ping.wantsAck || ping.type != "ping" || ping.payload != """{"type":"ping"}""" ||
+            ping.timestamp !in enrolledAt..now || now >= expiresAt || now >= ping.validUntil ||
+            ping.validUntil - ping.timestamp != 8000L || !ClientControlCrypto.verifyEnvelope(key, ping)) return null
+        val payload = Json.encodeToString(PongPayload.serializer(), PongPayload(signingPoint))
+        return ClientControlCrypto.signAck(key, AckEnvelope(clientId, ping.counter, AckPhase.Done, AckStatus.Ok,
+            payload = payload, timestamp = now, signature = ""))
+    }
+}
