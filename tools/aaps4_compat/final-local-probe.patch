+        if (!entry.localCopilot || entry.state != ClientState.Pending || entry.counterReceived != 1L ||
+            entry.pairExpiresAt != pending.expiresAt || entry.role != pending.role || entry.name != pending.name ||
+            !allowed() || !secureEncrypt.isValidDataString(wrapped)) return@withLock null
+        val key = ClientControlCrypto.hexToBytes(secureEncrypt.decrypt(wrapped))
+        val ack = try { LocalFirstPong.sign(key, entry.clientId, ping, entry.createdAt, entry.pairExpiresAt, clock(), signingPoint) }
+            finally { key.fill(0) }
+        if (ack == null || !allowed() || clock() !in ack.timestamp until minOf(entry.pairExpiresAt, ping.validUntil)) return@withLock null
+        write(list.map { if (it == entry) it.copy(counterReceived = ping.counter) else it })
+        ack
+    }
