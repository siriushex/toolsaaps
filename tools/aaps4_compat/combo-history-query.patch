+package app.aaps.core.nssdk.localmodel.clientcontrol
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertIs
+import kotlin.test.assertNull
+import kotlinx.serialization.json.*
+
+class ComboHistoryReadRequestTest {
+    private val client = "11111111-2222-4333-8444-555555555555"
+    private val master = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
+    private val request = "00000000-0000-4000-8000-000000000001"
+    private val snapshot = "00000000-0000-4000-8000-000000000002"
+    private val at = 1_800_000_000_000L
+    private fun inventory() = buildJsonObject { put("kind", "inventory"); put("limit", 32) }
+    private fun chunk() = buildJsonObject {
+        put("kind", "chunk"); put("snapshotId", snapshot); put("readId", request)
+        put("pumpBinding", "a".repeat(64)); put("sha256", "b".repeat(64))
+        put("totalBytes", 32771); put("offset", 32768); put("length", 3)
+    }
+    private fun root(query: JsonElement = inventory()) = buildJsonObject {
+        put("type", ComboHistoryReadRequest.TYPE); put("version", 1)
+        put("masterInstallId", master); put("requestId", request); put("query", query)
+    }
+    private fun envelope(payload: String = root().toString()) = SignedEnvelope(
+        client, 3, at, ComboHistoryReadRequest.TYPE, payload, "", at + 30000, true)
+    private fun JsonObject.changed(key: String, value: JsonElement?) = JsonObject(toMutableMap().apply {
+        if (value == null) remove(key) else put(key, value)
+    })
+    private fun rejected(env: SignedEnvelope = envelope(), owner: String = master, now: Long = at) {
+        val failure = assertFailsWith<IllegalArgumentException> { ComboHistoryReadRequest.decode(env, owner, now) }
+        assertEquals("combo_history_query_invalid", failure.message)
+        assertNull(failure.cause)
+    }
+    private fun rejectedQuery(query: JsonElement) = rejected(envelope(root(query).toString()))
+
+    @Test fun initialInventoryHasNoInventedCursorOrAuthority() {
+        val decoded = ComboHistoryReadRequest.decode(envelope(), master, at)
+        assertEquals(client, decoded.clientId); assertEquals(master, decoded.masterInstallId)
+        assertEquals(request, decoded.requestId); assertEquals(3L, decoded.counter)
+        assertEquals(at, decoded.issuedAt); assertEquals(at + 30000, decoded.validUntil)
+        val query = assertIs<ComboHistoryReadRequest.Inventory>(decoded.query)
+        assertEquals(32, query.limit); assertNull(query.snapshotId); assertNull(query.afterReadId)
+        // Deliberately unsigned: this is a syntax check, never authentication.
+        assertEquals("", envelope().signature)
+    }
+    @Test fun continuationAndInventoryLimits() {
+        for (limit in listOf(1, 32)) {
+            val body = inventory().changed("limit", JsonPrimitive(limit))
+                .changed("snapshotId", JsonPrimitive(snapshot)).changed("afterReadId", JsonPrimitive(request))
+            val decoded = ComboHistoryReadRequest.decode(envelope(root(body).toString()), master, at + 29999)
+            val query = assertIs<ComboHistoryReadRequest.Inventory>(decoded.query)
+            assertEquals(snapshot, query.snapshotId); assertEquals(request, query.afterReadId)
+            assertEquals(limit, query.limit)
+        }
+    }
+    @Test fun exactFirstMiddleLastAndMaximumChunks() {
+        for ((size, offset) in listOf(1 to 0, 32768 to 0, 32771 to 0, 32771 to 32768, 2097152 to 2064384)) {
+            val length = minOf(32768, size - offset)
+            val body = chunk().changed("totalBytes", JsonPrimitive(size)).changed("offset", JsonPrimitive(offset))
+                .changed("length", JsonPrimitive(length))
+            val query = assertIs<ComboHistoryReadRequest.Chunk>(ComboHistoryReadRequest.decode(envelope(root(body).toString()), master, at).query)
+            assertEquals(size, query.totalBytes); assertEquals(offset, query.offset); assertEquals(length, query.length)
+            assertEquals(snapshot, query.snapshotId); assertEquals(request, query.readId)
+            assertEquals("a".repeat(64), query.pumpBinding); assertEquals("b".repeat(64), query.sha256)
+        }
+    }
+    @Test fun wrongOuterTypeVersionAckAndCounterAreRejected() {
+        listOf("hello", "combo_history_read_v2", "combo_history_read_", "").forEach { rejected(envelope().copy(type = it)) }
+        rejected(envelope().copy(wantsAck = false))
+        listOf(Long.MIN_VALUE, -1, 0, 1).forEach { rejected(envelope().copy(counter = it)) }
+        listOf(JsonPrimitive(0), JsonPrimitive(2), JsonPrimitive("1"), JsonNull).forEach {
+            rejected(envelope(root().changed("version", it).toString()))
+        }
+    }
+    @Test fun exactOwnerAndCanonicalIdentitiesRequired() {
+        listOf(master.uppercase(), "../owner", "", "a-b-c-d-e").forEach {
+            rejected(owner = it); rejected(envelope().copy(clientId = it))
+            rejected(envelope(root().changed("requestId", JsonPrimitive(it)).toString()))
+        }
+        rejected(envelope().copy(clientId = master))
+        rejected(envelope(root().changed("masterInstallId", JsonPrimitive(client)).toString()))
+        for (field in listOf("snapshotId", "readId")) rejectedQuery(chunk().changed(field, JsonPrimitive("bad")))
+    }
+    @Test fun missingAndExtraRootAndQueryFieldsAreRejected() {
+        root().keys.forEach { rejected(envelope(root().changed(it, null).toString())) }
+        rejected(envelope(root().changed("bolus", JsonPrimitive(1)).toString()))
+        for (base in listOf(inventory(), chunk())) {
+            base.keys.forEach { rejectedQuery(base.changed(it, null)) }
+            rejectedQuery(base.changed("unexpected", JsonPrimitive(true)))
+        }
+        rejectedQuery(root()); rejectedQuery(JsonNull); rejectedQuery(JsonArray(emptyList()))
+        rejectedQuery(JsonPrimitive("inventory")); rejectedQuery(inventory().changed("kind", JsonPrimitive("bolus.commit")))
+    }
+    @Test fun halfCursorsExplicitNullsAndInventoryLimitsAreRejected() {
+        rejectedQuery(inventory().changed("snapshotId", JsonPrimitive(snapshot)))
+        rejectedQuery(inventory().changed("afterReadId", JsonPrimitive(request)))
+        rejectedQuery(inventory().changed("snapshotId", JsonNull).changed("afterReadId", JsonNull))
+        for (value in listOf(JsonPrimitive(-1), JsonPrimitive(0), JsonPrimitive(33), JsonPrimitive(Int.MAX_VALUE),
+            JsonPrimitive("32"), JsonPrimitive(true), JsonNull)) rejectedQuery(inventory().changed("limit", value))
+    }
+    @Test fun chunkGeometryNeverRoundsOrTruncates() {
+        for (size in listOf(-1, 0, 2097153, Int.MAX_VALUE)) rejectedQuery(chunk().changed("totalBytes", JsonPrimitive(size)))
+        for (offset in listOf(-32768, -1, 1, 32769, 32771, Int.MAX_VALUE)) rejectedQuery(chunk().changed("offset", JsonPrimitive(offset)))
+        for (length in listOf(-1, 0, 2, 4, 32768, Int.MAX_VALUE)) rejectedQuery(chunk().changed("length", JsonPrimitive(length)))
+        for (field in listOf("totalBytes", "offset", "length")) {
+            rejectedQuery(chunk().changed(field, JsonPrimitive("3"))); rejectedQuery(chunk().changed(field, JsonNull))
+        }
+    }
+    @Test fun bindingsAndDigestsUseClosedAlphabet() {
+        for (field in listOf("pumpBinding", "sha256")) for (value in listOf("A".repeat(64), "a".repeat(63),
+            "a".repeat(65), "../read", "a|b", "a\nb")) rejectedQuery(chunk().changed(field, JsonPrimitive(value)))
+    }
+    @Test fun lifetimeAndNowCheckAllBoundariesWithoutOverflow() {
+        rejected(now = at - 1); rejected(now = at + 30000); rejected(now = Long.MIN_VALUE); rejected(now = Long.MAX_VALUE)
+        for (time in listOf(Long.MIN_VALUE, -1, 0, 253_402_300_770_000L, Long.MAX_VALUE)) rejected(envelope().copy(timestamp = time))
+        for (until in listOf(Long.MIN_VALUE, at - 1, at, at + 30001, Long.MAX_VALUE)) rejected(envelope().copy(validUntil = until))
+        ComboHistoryReadRequest.decode(envelope().copy(validUntil = at + 1), master, at)
+    }
+    @Test fun duplicateKeysAtEitherLevelAreRejectedEvenWhenEqual() {
+        val raw = root().toString()
+        rejected(envelope(raw.replace("\"version\":1", "\"version\":1,\"version\":1")))
+        rejected(envelope(raw.replace("\"limit\":32", "\"limit\":1,\"limit\":32")))
+        rejected(envelope(raw.replace("\"query\":", "\"query\":{},\"query\":")))
+    }
+    @Test fun escapedKeysNumbersAndWhitespaceAreNotAlternateWireForms() {
+        val raw = root().toString()
+        listOf("1.0", "1e0", "+1", "01", "-0", "9999999999999999999999").forEach {
+            rejected(envelope(raw.replace("\"version\":1", "\"version\":$it")))
+        }
+        rejected(envelope(raw.replace("version", "ver\\u0073ion")))
+        rejected(envelope(" $raw")); rejected(envelope(raw.replace(",", ", ")))
+        rejected(envelope(raw.replace("\"limit\":32", "\"limit\":32,")))
+    }
+    @Test fun oversizedDeepAndMalformedPayloadsFailWithoutLeakingInput() {
+        listOf("", " ".repeat(2049), "{".repeat(1000) + "}".repeat(1000), "[".repeat(1000) + "]".repeat(1000),
+            "{}{}", "{", "}", "{\"query\":{\"extra\":{}}}", root().toString() + "\u0000", "{\"note\":\"личное\"}")
+            .forEach { rejected(envelope(it)) }
+    }
+    @Test fun descriptionsNeverContainRequestScope() {
+        for (body in listOf(inventory(), chunk())) {
+            val decoded = ComboHistoryReadRequest.decode(envelope(root(body).toString()), master, at)
+            for (sensitive in listOf(client, master, request, snapshot, "a".repeat(64), "b".repeat(64))) {
+                assertFalse(decoded.toString().contains(sensitive)); assertFalse(decoded.query.toString().contains(sensitive))
+            }
+        }
+    }
+}
