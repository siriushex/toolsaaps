+package app.aaps.core.nssdk.localmodel.clientcontrol
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+
+/** Structure only. The paired owner must verify MAC, replay and lifecycle before using it. */
+class ComboHistoryReadRequest private constructor(
+    val clientId: String,
+    val masterInstallId: String,
+    val requestId: String,
+    val counter: Long,
+    val issuedAt: Long,
+    val validUntil: Long,
+    val query: Query
+) {
+    sealed interface Query
+
+    class Inventory internal constructor(val snapshotId: String?, val afterReadId: String?, val limit: Int) : Query {
+        override fun toString() = "ComboInventoryQuery(redacted)"
+    }
+
+    class Chunk internal constructor(
+        val snapshotId: String, val readId: String, val pumpBinding: String, val sha256: String,
+        val totalBytes: Int, val offset: Int, val length: Int
+    ) : Query {
+        override fun toString() = "ComboChunkQuery(redacted)"
+    }
+
+    override fun toString() = "ComboHistoryReadRequest(redacted)"
+
+    companion object {
+        const val TYPE = "combo_history_read_v1"
+        private const val MAX_TIME = 253_402_300_799_999L
+        private const val TTL_MS = 30_000L
+        private const val MAX_PAYLOAD_CHARS = 2048
+        private const val MAX_READ_BYTES = 2 * 1024 * 1024
+        private const val CHUNK_BYTES = 32768
+        private val UUID = Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+        private val HASH = Regex("[0-9a-f]{64}")
+        private val ROOT_KEYS = setOf("type", "version", "masterInstallId", "requestId", "query")
+        private val INVENTORY_KEYS = setOf("kind", "limit")
+        private val CURSOR_KEYS = INVENTORY_KEYS + setOf("snapshotId", "afterReadId")
+        private val CHUNK_KEYS = setOf("kind", "snapshotId", "readId", "pumpBinding", "sha256", "totalBytes", "offset", "length")
+
+        /** Does not authenticate [envelope] or consume its counter; the caller owns both checks. */
+        fun decode(envelope: SignedEnvelope, expectedMasterInstallId: String, now: Long): ComboHistoryReadRequest = try {
+            require(UUID.matches(envelope.clientId) && UUID.matches(expectedMasterInstallId))
+            require(envelope.clientId != expectedMasterInstallId && envelope.counter > 1)
+            require(envelope.type == TYPE && envelope.wantsAck)
+            require(envelope.timestamp in 1..MAX_TIME - TTL_MS)
+            require(envelope.validUntil > envelope.timestamp && envelope.validUntil - envelope.timestamp <= TTL_MS)
+            require(now >= envelope.timestamp && now < envelope.validUntil)
+            val payload = envelope.payload
+            checkFraming(payload)
+            val root = Json.parseToJsonElement(payload) as? JsonObject ?: invalid()
+            // The sender signs compact JSON verbatim. Re-encoding rejects duplicate keys
+            // and noncanonical whitespace without implementing another JSON parser.
+            require(root.toString() == payload && root.keys == ROOT_KEYS)
+            require(root.string("type") == TYPE && root.integer("version") == 1)
+            require(root.string("masterInstallId") == expectedMasterInstallId)
+            val requestId = root.identifier("requestId")
+            val body = root["query"] as? JsonObject ?: invalid()
+            val query = when (body.string("kind")) {
+                "inventory" -> {
+                    require(body.keys == INVENTORY_KEYS || body.keys == CURSOR_KEYS)
+                    val limit = body.integer("limit")
+                    require(limit in 1..32)
+                    Inventory(
+                        if ("snapshotId" in body) body.identifier("snapshotId") else null,
+                        if ("afterReadId" in body) body.identifier("afterReadId") else null,
+                        limit
+                    )
+                }
+                "chunk" -> {
+                    require(body.keys == CHUNK_KEYS)
+                    val snapshotId = body.identifier("snapshotId")
+                    val readId = body.identifier("readId")
+                    val pumpBinding = body.string("pumpBinding").also { require(HASH.matches(it)) }
+                    val sha256 = body.string("sha256").also { require(HASH.matches(it)) }
+                    val totalBytes = body.integer("totalBytes")
+                    val offset = body.integer("offset")
+                    val length = body.integer("length")
+                    require(totalBytes in 1..MAX_READ_BYTES)
+                    require(offset in 0 until totalBytes && offset % CHUNK_BYTES == 0)
+                    require(length == minOf(CHUNK_BYTES, totalBytes - offset))
+                    Chunk(snapshotId, readId, pumpBinding, sha256, totalBytes, offset, length)
+                }
+                else -> invalid()
+            }
+            ComboHistoryReadRequest(envelope.clientId, expectedMasterInstallId, requestId,
+                envelope.counter, envelope.timestamp, envelope.validUntil, query)
+        } catch (_: Exception) {
+            invalid()
+        }
+
+        private fun checkFraming(raw: String) {
+            require(raw.length in 1..MAX_PAYLOAD_CHARS)
+            var depth = 0
+            var quoted = false
+            for (char in raw) {
+                // This version contains only closed ASCII identifiers and numeric fields.
+                require(char in ' '..'~' && char != '\\')
+                if (char == '"') quoted = !quoted
+                else if (!quoted) when (char) {
+                    '{' -> { depth++; require(depth <= 2) }
+                    '}' -> { depth--; require(depth >= 0) }
+                    '[', ']' -> invalid()
+                }
+            }
+            require(!quoted && depth == 0)
+        }
+
+        private fun JsonObject.string(name: String): String {
+            val value = this[name] as? JsonPrimitive ?: invalid()
+            require(value.isString)
+            return value.content
+        }
+
+        private fun JsonObject.identifier(name: String) = string(name).also { require(UUID.matches(it)) }
+
+        private fun JsonObject.integer(name: String): Int {
+            val value = this[name] as? JsonPrimitive ?: invalid()
+            require(!value.isString)
+            val number = value.content.toIntOrNull() ?: invalid()
+            require(number.toString() == value.content)
+            return number
+        }
+
+        private fun invalid(): Nothing = throw IllegalArgumentException("combo_history_query_invalid")
+    }
+}
diff --git a/core/nssdk/src/commonTest/kotlin/app/aaps/core/nssdk/localmodel/clientcontrol/ComboHistoryReadRequestTest.kt b/core/nssdk/src/commonTest/kotlin/app/aaps/core/nssdk/localmodel/clientcontrol/ComboHistoryReadRequestTest.kt
