+package app.aaps.plugins.sync.nsclientV3.localpin
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.ClientControlMessage
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingPayload
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import app.aaps.core.nssdk.networking.NsLocalSettingsPolling
+import app.aaps.core.nssdk.networking.NsLoopbackUploadIdentity
+import app.aaps.core.nssdk.utils.ClientControlCrypto
+import io.socket.client.Ack
+import io.socket.client.IO
+import io.socket.client.Socket
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.Json
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.Base64
+
+/** Enrollment only: never executes a command or marks an AAPS client active. */
+internal object LocalPinHelloPeer {
+    suspend fun exchange(port: Int, identity: NsLoopbackUploadIdentity, bearer: String,
+                         pending: PairingPayload, accept: suspend (SignedEnvelope) -> Boolean): Boolean {
+        require(Regex("ls1\\.[A-Za-z0-9_-]{43}").matches(bearer))
+        val initial = System.currentTimeMillis()
+        val remaining = pending.expiresAt - initial
+        if (remaining !in 1..600_000) return false
+        val key = ClientControlCrypto.hexToBytes(pending.secretHex)
+        return try {
+            NsLocalSettingsPolling(identity, port).use { calls ->
+                val socket = IO.socket("https://127.0.0.1:$port/storage", IO.Options().apply {
+                    callFactory = calls; forceNew = true; multiplex = false
+                    transports = arrayOf("polling"); upgrade = false; reconnection = false
+                })
+                val subscribed = CompletableDeferred<Boolean>()
+                val received = CompletableDeferred<SignedEnvelope?>()
+                fun lost() { subscribed.complete(false); received.complete(null) }
+                try {
+                    socket.on(Socket.EVENT_CONNECT_ERROR) { lost() }
+                    socket.on(Socket.EVENT_DISCONNECT) { lost() }
+                    socket.on(Socket.EVENT_CONNECT) {
+                        socket.emit("subscribe", JSONObject().put("accessToken", bearer)
+                            .put("collections", JSONArray(listOf("settings"))), Ack { args ->
+                            val reply = args.singleOrNull() as? JSONObject
+                            subscribed.complete(reply?.optBoolean("success") == true && reply.optJSONArray("collections")?.let {
+                                it.length() == 1 && it.optString(0) == "settings"
+                            } == true)
+                        })
+                    }
+                    // A hello may update a retained identifier. Only accept one, and never accept a control frame here.
+                    for (event in listOf("create", "update")) socket.on(event) { args ->
+                        val frame = args.singleOrNull() as? JSONObject ?: return@on
+                        val doc = frame.optJSONObject("doc") ?: return@on
+                        if (frame.optString("colName") != "settings" ||
+                            doc.optString("identifier") != "aaps_clientcontrol_hello_${pending.clientId}") return@on
+                        val raw = doc.optJSONObject("envelope")?.toString() ?: return@on
+                        val env = if (raw.length <= 4096) runCatching { Json.decodeFromString(SignedEnvelope.serializer(), raw) }.getOrNull() else null
+                        received.complete(env)
+                    }
+                    withTimeoutOrNull(minOf(120_000L, remaining)) {
+                        socket.connect()
+                        if (!subscribed.await()) return@withTimeoutOrNull false
+                        val env = received.await() ?: return@withTimeoutOrNull false
+                        val now = System.currentTimeMillis()
+                        socket.connected() && env.clientId == pending.clientId && env.type == "hello" && env.counter == 1L && !env.wantsAck &&
+                            env.validUntil == pending.expiresAt && now in initial until pending.expiresAt &&
+                            env.timestamp in initial..now && ClientControlCrypto.verifyEnvelope(key, env) &&
+                            hasKeyExchangeHello(env.payload) && accept(env)
+                    } == true
+                } finally { socket.off(); socket.close() }
+            }
+        } finally { key.fill(0) }
+    }
+
+    private fun hasKeyExchangeHello(raw: String): Boolean = runCatching {
+        val hello = Json.decodeFromString(ClientControlMessage.serializer(), raw) as? ClientControlMessage.Hello
+        val point = hello?.publicKey ?: return false
+        val bytes = Base64.getDecoder().decode(point)
+        hello.protocolVersion == 1 && bytes.size == 65 && bytes[0] == 4.toByte() &&
+            Base64.getEncoder().encodeToString(bytes) == point
+    }.getOrDefault(false)
+}
