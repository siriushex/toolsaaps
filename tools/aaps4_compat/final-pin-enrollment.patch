+package app.aaps.core.nssdk.utils
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingOffer
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingPayload
+import kotlinx.serialization.json.Json
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/** Same wire document for Nightscout and an explicitly selected same-phone handoff. */
+@OptIn(ExperimentalEncodingApi::class)
+object ClientControlPinOffer {
+    private val codec = Json { encodeDefaults = true }
+
+    fun wrap(payload: PairingPayload, pin: String): PairingOffer {
+        val salt = ClientControlPairingCrypto.newSalt()
+        val iv = ClientControlPairingCrypto.newIv()
+        val plain = codec.encodeToString(PairingPayload.serializer(), payload).encodeToByteArray()
+        val wrapped = try { ClientControlPairingCrypto.wrap(plain, pin, salt, iv) } finally { plain.fill(0) }
+        return PairingOffer(clientId = payload.clientId, expiresAt = payload.expiresAt,
+            kdfSaltB64 = Base64.Default.encode(salt), ivB64 = Base64.Default.encode(iv),
+            wrappedB64 = Base64.Default.encode(wrapped))
+    }
+}
