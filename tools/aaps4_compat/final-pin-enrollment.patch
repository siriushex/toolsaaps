+package app.aaps.plugins.sync.nsclientV3.localpin
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Bundle
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingOffer
+import app.aaps.core.nssdk.localmodel.clientcontrol.PairingPayload
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import app.aaps.core.nssdk.networking.NsLoopbackUploadIdentity
+import app.aaps.core.nssdk.utils.ClientControlPinOffer
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import java.util.UUID
+
+/** One explicit local enrollment. No Nightscout settings, global TLS or stored session changes. */
+internal class LocalCopilotPinEnrollment(private val context: Context) {
+    suspend fun exchange(pending: PairingPayload, pin: String, acceptHello: suspend (SignedEnvelope) -> Boolean): Boolean =
+        withContext(Dispatchers.IO) {
+            val pm = context.packageManager
+            fun trusted(): Boolean {
+                val provider = pm.resolveContentProvider(AUTHORITY, 0) ?: return false
+                return context.packageName == MASTER && provider.packageName == PEER &&
+                    provider.exported && !provider.grantUriPermissions && provider.readPermission == PERMISSION &&
+                    provider.writePermission == PERMISSION && pm.checkSignatures(MASTER, PEER) == PackageManager.SIGNATURE_MATCH
+            }
+            try {
+                if (!trusted() || !pin.matches(Regex("[0-9]{8}"))) return@withContext false
+                val wrapped = codec.encodeToString(PairingOffer.serializer(), ClientControlPinOffer.wrap(pending, pin)).encodeToByteArray()
+                try {
+                    context.contentResolver.acquireUnstableContentProviderClient(Uri.parse("content://$AUTHORITY"))?.use { provider ->
+                        if (!trusted() || wrapped.size !in 1..4096) return@use false
+                        val receipt = provider.call("local_pin_offer_v1", null, Bundle().apply { putByteArray("wrapped", wrapped) })
+                            ?: return@use false
+                        val handle = receipt.getString("handle")?.takeIf { it.length == 36 && UUID.fromString(it).toString() == it }
+                            ?: return@use false
+                        try {
+                            if (receipt.keySet() != setOf("ticket", "handle") || !trusted()) return@use false
+                            val ticket = receipt.getBundle("ticket") ?: return@use false
+                            if (ticket.keySet() != setOf("root", "leaf", "port", "bearer")) return@use false
+                            val root = ticket.getByteArray("root")?.takeIf { it.size in 1..8192 } ?: return@use false
+                            val leaf = ticket.getByteArray("leaf")?.takeIf { it.size in 1..8192 } ?: return@use false
+                            val port = ticket.getInt("port").takeIf { it in 1..65535 } ?: return@use false
+                            val bearer = ticket.getString("bearer") ?: return@use false
+                            LocalPinHelloPeer.exchange(port, NsLoopbackUploadIdentity(root, leaf), bearer, pending, acceptHello)
+                        } finally {
+                            // Same acquired peer and offer only. Unknown IPC outcomes are never retried.
+                            try {
+                                if (trusted()) provider.call("withdraw_local_pin_v1", null, Bundle().apply {
+                                    putString("client", pending.clientId); putString("handle", handle)
+                                })
+                            } catch (_: android.os.RemoteException) {
+                                // The short ticket expires on the peer. Do not replace an accepted result or cancellation.
+                            }
+                        }
+                    } == true
+                } finally { wrapped.fill(0) }
+            } catch (e: CancellationException) { throw e }
+            catch (_: Exception) { false }
+        }
+
+    private companion object {
+        const val MASTER = "info.nightscout.androidaps"
+        const val PEER = "io.aaps.predictivecopilot"
+        const val AUTHORITY = "$PEER.localclient"
+        const val PERMISSION = "$PEER.permission.ISSUE_LOCAL_CLIENT_TOKEN"
+        val codec = Json { encodeDefaults = true }
+    }
+}
