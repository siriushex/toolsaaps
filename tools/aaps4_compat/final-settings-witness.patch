+package app.aaps.plugins.sync.nsclientV3.localpin
+
+import app.aaps.core.nssdk.localmodel.clientcontrol.SignedEnvelope
+import app.aaps.core.nssdk.networking.NsLocalSettingsPolling
+import app.aaps.core.nssdk.networking.NsLoopbackUploadIdentity
+import app.aaps.core.nssdk.utils.LocalSessionWitness
+import io.socket.client.Ack
+import io.socket.client.IO
+import io.socket.client.Socket
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.Json
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** A post-enrollment challenge received on the pinned settings namespace, not over Binder. */
+object LocalSessionSettingsPeer {
+    suspend fun receive(port: Int, identity: NsLoopbackUploadIdentity, bearer: String, master: String, nonce: String,
+                        clock: () -> Long = System::currentTimeMillis): SignedEnvelope? {
+        if (port !in 1..65535 || !Regex("ls1\\.[A-Za-z0-9_-]{43}").matches(bearer)) return null
+        return NsLocalSettingsPolling(identity, port).use { calls ->
+            val socket = IO.socket("https://127.0.0.1:$port/storage", IO.Options().apply {
+                callFactory = calls; forceNew = true; multiplex = false
+                transports = arrayOf("polling"); upgrade = false; reconnection = false
+            })
+            val subscribed = CompletableDeferred<Boolean>()
+            val frame = CompletableDeferred<SignedEnvelope?>()
+            fun lost() { subscribed.complete(false); frame.complete(null) }
+            try {
+                socket.on(Socket.EVENT_DISCONNECT) { lost() }
+                socket.on(Socket.EVENT_CONNECT_ERROR) { lost() }
+                socket.on(Socket.EVENT_CONNECT) {
+                    socket.emit("subscribe", JSONObject().put("accessToken", bearer)
+                        .put("collections", JSONArray(listOf("settings"))), Ack { args ->
+                        val ack = args.singleOrNull() as? JSONObject
+                        subscribed.complete(ack?.optBoolean("success") == true && ack.optJSONArray("collections")?.let {
+                            it.length() == 1 && it.optString(0) == "settings"
+                        } == true)
+                    })
+                }
+                socket.on("local_session_witness_v1") { args ->
+                    val raw = (args.singleOrNull() as? JSONObject)?.toString()
+                    frame.complete(if (raw != null && raw.length in 1..2048)
+                        runCatching { Json.decodeFromString(SignedEnvelope.serializer(), raw) }.getOrNull() else null)
+                }
+                withTimeoutOrNull(4500L) {
+                    socket.connect()
+                    if (!subscribed.await()) return@withTimeoutOrNull null
+                    frame.await()?.takeIf { socket.connected() && LocalSessionWitness.accepts(it, master, nonce, clock()) }
+                }
+            } finally { socket.off(); socket.close() }
+        }
+    }
+}
