@@ -1158,2 +1158,44 @@ internal class ClientControlReceiverTest {
         assertThat(preview.lines.single().text).isEqualTo("1.5 U")
+        assertThat(preview.manualMeal).isNull()
+    }
+
+    private val scopedMeal = BatchActionDto(type = BatchActionDto.TYPE_BOLUS, carbs = 12, notes = "copilot:manual:meal:sample")
+    private fun mealPreview(grams: Int) = MasterActionExecutor.PrepareResult.Preview(
+        insulin = 0.0, carbs = grams, bolusId = 79L, lines = listOf(ConfirmationLine(ConfirmationRole.NORMAL, "sample")),
+        advisorApplies = false, advisorLines = emptyList()
+    )
+
+    @Test
+    fun manualMealPreviewIsSignedAndDoesNotCommit() = runTest {
+        val (id, key) = activeClient(ClientRole.MealAssistant)
+        val acks = captureAcks(id)
+        whenever(masterActionExecutor.prepareBatch(any(), anyOrNull())).thenReturn(mealPreview(12))
+        sendBatch(id, key, listOf(scopedMeal))
+        val ack = acks.last()
+        assertThat(ClientControlCrypto.verifyAck(key, ack)).isTrue()
+        val preview = Json.decodeFromString<BolusPreview>(checkNotNull(ack.payload))
+        assertThat(preview.manualMeal?.marker).isEqualTo(scopedMeal.notes)
+        assertThat(preview.manualMeal?.carbsGrams).isEqualTo(12)
+        assertThat(preview.manualMeal?.insulinUnits).isEqualTo(0.0)
+        verify(masterActionExecutor, never()).confirm(any(), any(), any(), any(), any(), anyOrNull(), any())
+    }
+
+    @Test
+    fun manualMealCappedByMasterIsDiscarded() = runTest {
+        val (id, key) = activeClient(ClientRole.MealAssistant)
+        val acks = captureAcks(id)
+        whenever(masterActionExecutor.prepareBatch(any(), anyOrNull())).thenReturn(mealPreview(8))
+        sendBatch(id, key, listOf(scopedMeal))
+        assertThat(acks.last().status.name).isEqualTo("Failed")
+        assertThat(acks.last().payload).isNull()
+        verify(masterActionExecutor).discard(79L)
+    }
+
+    @Test
+    fun manualMealMixedWithAnotherActionNeverParks() = runTest {
+        val (id, key) = activeClient(ClientRole.Admin)
+        val acks = captureAcks(id)
+        sendBatch(id, key, listOf(scopedMeal, tempTargetAction))
+        assertThat(acks.last().status.name).isEqualTo("Failed")
+        verify(masterActionExecutor, never()).prepareBatch(any(), anyOrNull())
     }
