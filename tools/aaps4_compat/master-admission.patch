+package app.aaps.database
+
+import app.aaps.database.di.JvmAppDatabaseBuilder
+import app.aaps.database.entities.TemporaryTarget
+import app.aaps.database.transactions.CancelCurrentTemporaryTargetIfAnyTransaction
+import app.aaps.database.transactions.InsertAndCancelCurrentTemporaryTargetTransaction
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.async
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.runCurrent
+import kotlin.io.path.createTempDirectory
+import kotlin.test.AfterTest
+import kotlin.test.Test
+
+/** Synthetic targets, real Room transactions and bundled SQLite; no therapy runtime. */
+class TargetAdmissionTransactionTest {
+    private val directory = createTempDirectory("target-admission-")
+    private val database = JvmAppDatabaseBuilder().provideAppDatabase("$directory/test.db")
+    private val repository = AppRepository { database }
+
+    @AfterTest
+    fun close() {
+        repository.close()
+        database.close()
+        directory.toFile().deleteRecursively()
+    }
+
+    @Test
+    fun rejectionAtEveryInsertionBoundaryPreservesOriginalTarget() = runTest {
+        repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(1_000L, 120.0)))
+        var changes = 0
+        val observer = backgroundScope.launch(start = CoroutineStart.UNDISPATCHED) { repository.changeFlow().collect { changes++ } }
+        for (refuseAt in 1..3) {
+            var calls = 0
+            val refusal = IllegalStateException("expired")
+            val result = runCatching {
+                repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(2_000L, 90.0)) {
+                    if (++calls == refuseAt) throw refusal
+                })
+            }
+            assertThat(result.exceptionOrNull()).isInstanceOf(IllegalStateException::class.java)
+            assertThat(result.exceptionOrNull()!!.message).isEqualTo(refusal.message)
+            val current = database.temporaryTargetDao.getTemporaryTargetActiveAtLegacy(3_000L)
+            assertThat(current!!.lowTarget).isEqualTo(120.0)
+            assertThat(current.duration).isEqualTo(60_000L)
+            assertThat(database.temporaryTargetDao.getLastId()).isEqualTo(1L)
+        }
+        runCurrent()
+        assertThat(changes).isEqualTo(0)
+        observer.cancel()
+    }
+
+    @Test
+    fun rejectionAfterCancellationWriteRollsBackCancellation() = runTest {
+        repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(1_000L, 120.0)))
+        for (refuseAt in 1..3) {
+            var calls = 0
+            val refusal = IllegalStateException("revoked")
+            val result = runCatching {
+                repository.runTransactionForResultSuspend(CancelCurrentTemporaryTargetIfAnyTransaction(2_000L) {
+                    if (++calls == refuseAt) throw refusal
+                })
+            }
+            assertThat(result.exceptionOrNull()).isInstanceOf(IllegalStateException::class.java)
+            assertThat(result.exceptionOrNull()!!.message).isEqualTo(refusal.message)
+            assertThat(database.temporaryTargetDao.getTemporaryTargetActiveAt(3_000L)!!.duration).isEqualTo(60_000L)
+        }
+    }
+
+    @Test
+    fun suspensionInsideTransactionCannotApplyRevokedTarget() = runTest {
+        repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(1_000L, 120.0)))
+        val reached = CompletableDeferred<Unit>()
+        val resume = CompletableDeferred<Unit>()
+        var allowed = true
+        var calls = 0
+        val work = async {
+            runCatching {
+                repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(2_000L, 90.0)) {
+                    if (++calls == 3) {
+                        reached.complete(Unit)
+                        resume.await()
+                    }
+                    check(allowed) { "revoked" }
+                })
+            }
+        }
+        reached.await()
+        allowed = false
+        resume.complete(Unit)
+        assertThat(work.await().isFailure).isTrue()
+        assertThat(database.temporaryTargetDao.getTemporaryTargetActiveAtLegacy(3_000L)!!.lowTarget).isEqualTo(120.0)
+    }
+
+    @Test
+    fun admittedInsertAndCancelCommitNormally() = runTest {
+        var calls = 0
+        val inserted = repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(1_000L, 90.0)) { calls++ })
+        assertThat(inserted.inserted).hasSize(1)
+        assertThat(calls).isEqualTo(3)
+        assertThat(database.temporaryTargetDao.getTemporaryTargetActiveAtLegacy(2_000L)!!.lowTarget).isEqualTo(90.0)
+        val cancelled = repository.runTransactionForResultSuspend(CancelCurrentTemporaryTargetIfAnyTransaction(2_000L) {})
+        assertThat(cancelled.updated).hasSize(1)
+        assertThat(database.temporaryTargetDao.getTemporaryTargetActiveAt(3_000L)).isNull()
+    }
+
+    @Test
+    fun cancelledOwnerRollsBackEvenInsideNonCancellableRepository() = runTest {
+        repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(1_000L, 120.0)))
+        val owner = Job()
+        var calls = 0
+        val result = runCatching {
+            repository.runTransactionForResultSuspend(InsertAndCancelCurrentTemporaryTargetTransaction(target(2_000L, 90.0)) {
+                if (++calls == 3) owner.cancel()
+                owner.ensureActive()
+            })
+        }
+        assertThat(result.isFailure).isTrue()
+        assertThat(database.temporaryTargetDao.getTemporaryTargetActiveAtLegacy(3_000L)!!.lowTarget).isEqualTo(120.0)
+        assertThat(database.temporaryTargetDao.getLastId()).isEqualTo(1L)
+    }
+
+    private fun target(timestamp: Long, value: Double) = TemporaryTarget(
+        timestamp = timestamp, duration = 60_000L, reason = TemporaryTarget.Reason.CUSTOM,
+        lowTarget = value, highTarget = value
+    )
+}
