+/** Admission budget includes network/mutex waits; wall-clock rollback cannot renew it. */
+internal class ClientControlCommandDeadline(
+    private val receivedAt: Long,
+    private val receivedMark: TimeMark = TimeSource.Monotonic.markNow()
+) {
+    fun expired(validUntil: Long, now: Long): Boolean =
+        receivedAt < 0L || now < receivedAt || validUntil <= receivedAt || now >= validUntil ||
+            receivedMark.elapsedNow() >= (validUntil - receivedAt).milliseconds
+}
