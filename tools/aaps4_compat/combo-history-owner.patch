+    @Test fun wallClockRewindDoesNotRenewSnapshot() = runTest {
+        val chunk = chunkRequest()
+        now--
+        refused { send(chunk) }
+    }
+
+    @Test fun cancelledOpenDisposesReaderAndSendsNothing() = runTest {
+        val entered = CompletableDeferred<Unit>()
+        val held = CompletableDeferred<Unit>()
+        var checks = 0
+        val job = async { send(admit = { if (++checks == 2) { entered.complete(Unit); held.await() } }) }
+        entered.await()
+        job.cancelAndJoin()
+        assertThat(reader.closed).isTrue()
+        assertThat(sent).isEmpty()
+    }
+
+    @Test fun busyReaderDoesNotQueueOrInvalidateCurrentWork() = runTest {
+        val entered = CompletableDeferred<Unit>()
+        val release = CompletableDeferred<Unit>()
+        var checks = 0
+        val first = async { send(admit = { if (++checks == 1) { entered.complete(Unit); release.await() } }) }
+        entered.await()
+        refused { send() }
+        release.complete(Unit)
+        first.await()
+        assertThat(sent).hasSize(1)
+        assertThat(opens).isEqualTo(1)
+    }
+
+    @Test fun uncertainPublicationIsNotRetriedAndClosesSnapshot() = runTest {
+        var attempts = 0
+        refused {
+            owner.respond(request(), secret, "wrapped-fixture", 1L, {}) {
+                attempts++
+                error("synthetic transport detail must not escape")
+            }
+        }
+        assertThat(attempts).isEqualTo(1)
+        assertThat(reader.closed).isTrue()
+    }
+}
