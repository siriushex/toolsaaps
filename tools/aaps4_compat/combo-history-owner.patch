+package app.aaps.plugins.sync.nsclientV3.clientcontrol
+
+import app.aaps.core.interfaces.pump.RetainedPumpHistory
+import app.aaps.core.interfaces.pump.RetainedPumpHistorySource
+import app.aaps.core.nssdk.localmodel.clientcontrol.ComboHistoryReadReply
+import app.aaps.core.nssdk.localmodel.clientcontrol.ComboHistoryReadRequest
+import app.aaps.core.nssdk.utils.ClientControlCrypto
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.sync.Mutex
+
+/** One bounded read-only snapshot. Authentication and publication belong to the receiver. */
+internal class ComboHistoryReadOwner(
+    private val source: () -> RetainedPumpHistorySource?,
+    private val now: () -> Long
+) {
+    private class Snapshot(
+        val clientId: String, val masterId: String, val credential: String, val createdAt: Long,
+        val source: RetainedPumpHistorySource, val reader: RetainedPumpHistory,
+        val reply: ComboHistoryReadReply, val deadline: ClientControlCommandDeadline, val expiresAt: Long
+    )
+
+    private val mutex = Mutex()
+    private var retained: Snapshot? = null
+
+    // The caller never queues work behind this permit and never holds a therapy lock here.
+    suspend fun respond(
+        request: ComboHistoryReadRequest, secret: ByteArray, credential: String, createdAt: Long,
+        admit: suspend () -> Unit, publish: suspend (String) -> Unit
+    ) {
+        if (!mutex.tryLock()) unavailable()
+        try {
+            currentCoroutineContext().ensureActive()
+            admit()
+            val initial = (request.query as? ComboHistoryReadRequest.Inventory)?.snapshotId == null &&
+                request.query is ComboHistoryReadRequest.Inventory
+            if (initial) {
+                discard()
+                val provider = source() ?: unavailable()
+                val reader = provider.openRetainedHistory()
+                var adopted = false
+                try {
+                    currentCoroutineContext().ensureActive()
+                    admit()
+                    check(source() === provider)
+                    reader.requireCurrent()
+                    check(reader.reads.size <= 4096)
+                    val reply = ComboHistoryReadReply.create(
+                        request.clientId, request.masterInstallId, ClientControlCrypto.newClientId(), reader.pumpBinding,
+                        reader.reads.map { ComboHistoryReadReply.Read(it.id, it.byteCount, it.sha256,
+                            it.closed, it.corrupt, it.adverse, it.readFailed) },
+                        reader.unscopedCorruptReads, reader.writerFailed
+                    )
+                    val at = now()
+                    check(at in 1..253_402_300_499_999L)
+                    retained = Snapshot(request.clientId, request.masterInstallId, credential, createdAt,
+                        provider, reader, reply, ClientControlCommandDeadline(at), at + 300_000L)
+                    adopted = true
+                } finally {
+                    if (!adopted) runCatching { reader.close() }
+                }
+            }
+            val snapshot = retained ?: unavailable()
+            check(snapshot.clientId == request.clientId && snapshot.masterId == request.masterInstallId &&
+                snapshot.credential == credential && snapshot.createdAt == createdAt)
+            suspend fun guard() {
+                currentCoroutineContext().ensureActive()
+                admit()
+                check(!snapshot.deadline.expired(snapshot.expiresAt, now()) && source() === snapshot.source)
+                snapshot.reader.requireCurrent()
+            }
+            guard()
+            val chunk = (request.query as? ComboHistoryReadRequest.Chunk)?.let {
+                snapshot.reader.readChunk(it.readId, it.offset, it.length)
+            }
+            try {
+                guard()
+                val sealed = snapshot.reply.seal(request, secret, now(), chunk)
+                try {
+                    guard()
+                    publish(sealed.decodeToString())
+                    // A completed network call is not a retention or physical-delivery receipt.
+                    guard()
+                } finally { sealed.fill(0) }
+            } finally { chunk?.fill(0) }
+        } catch (cancelled: CancellationException) {
+            discard()
+            throw cancelled
+        } catch (_: Exception) {
+            discard()
+            unavailable()
+        } finally { mutex.unlock() }
+    }
+
+    private fun discard() {
+        val old = retained
+        retained = null
+        old?.let { runCatching { it.reader.close() } }
+    }
+
+    private fun unavailable(): Nothing = throw IllegalStateException("combo_history_unavailable")
+}
