+internal class SyntheticRetainedHistory : RetainedPumpHistory {
+    override val pumpBinding = "a".repeat(64)
+    val raw = byteArrayOf(0, 5, 9)
+    val id = "00000000-0000-4000-8000-000000000001"
+    val hash = ClientControlCrypto.bytesToHex(MessageDigest.getInstance("SHA-256").digest(raw))
+    override val reads = listOf(RetainedPumpHistoryRead(id, raw.size, hash, true, false, true, false))
+    override val unscopedCorruptReads = 2
+    override val writerFailed = false
+    var closed = false
+    var valid = true
+    var chunks = 0
+    var outgoing: ByteArray? = null
+    var afterRead: () -> Unit = {}
+    override fun requireCurrent() { check(valid && !closed) }
+    override fun readChunk(readId: String, offset: Int, byteCount: Int): ByteArray {
+        requireCurrent()
+        check(readId == id && offset == 0 && byteCount == raw.size)
+        chunks++
+        return raw.copyOf().also { outgoing = it; afterRead() }
+    }
+    override fun close() { closed = true }
+}
