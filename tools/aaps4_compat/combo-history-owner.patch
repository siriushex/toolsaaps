+internal class ComboHistoryReadOwnerTest {
+    private val client = "11111111-2222-4333-8444-555555555555"
+    private val master = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
+    private val requestId = "00000000-0000-4000-8000-000000000002"
+    private val secret = ByteArray(32) { 17 }
+    private var now = 1_800_000_000_000L
+    private var counter = 1L
+    private val reader = SyntheticRetainedHistory()
+    private var opens = 0
+    private var afterOpen: () -> Unit = {}
+    private val provider = object : RetainedPumpHistorySource {
+        override fun openRetainedHistory(): RetainedPumpHistory = reader.also { opens++; afterOpen() }
+    }
+    private var active: RetainedPumpHistorySource? = provider
+    private val owner = ComboHistoryReadOwner({ active }, { now })
+    private val sent = mutableListOf<String>()
+
+    private fun request(query: JsonObject = buildJsonObject { put("kind", "inventory"); put("limit", 32) },
+                        who: String = client): ComboHistoryReadRequest {
+        val payload = buildJsonObject {
+            put("type", ComboHistoryReadRequest.TYPE); put("version", 1); put("masterInstallId", master)
+            put("requestId", requestId); put("query", query)
+        }.toString()
+        return ComboHistoryReadRequest.decode(SignedEnvelope(who, ++counter, now,
+            ComboHistoryReadRequest.TYPE, payload, "", now + 30_000L, true), master, now)
+    }
+
+    private suspend fun send(r: ComboHistoryReadRequest = request(), credential: String = "wrapped-fixture",
+                             created: Long = 1L, admit: suspend () -> Unit = {}) {
+        owner.respond(r, secret, credential, created, admit) { sent += it }
+    }
+
+    private fun context(r: ComboHistoryReadRequest): String = when (val q = r.query) {
+        is ComboHistoryReadRequest.Inventory -> listOf("aaps-combo-inventory-page-v1", "master-to-client", "aes-256-gcm",
+            client, master, r.requestId, r.counter, r.issuedAt, r.validUntil, q.snapshotId ?: "-", q.afterReadId ?: "-", q.limit).joinToString("|")
+        is ComboHistoryReadRequest.Chunk -> listOf("aaps-combo-journal-chunk-v1", "master-to-client", "aes-256-gcm",
+            client, master, r.requestId, q.snapshotId, q.readId, q.pumpBinding, q.sha256,
+            r.counter, r.issuedAt, r.validUntil, q.totalBytes, q.offset, q.length).joinToString("|")
+    }
+
+    private fun open(r: ComboHistoryReadRequest): ByteArray {
+        val frame = Json.parseToJsonElement(sent.last()).jsonObject
+        fun bytes(name: String) = Base64.decode(frame.getValue(name).jsonPrimitive.content)
+        val context = context(r).encodeToByteArray()
+        fun hmac(key: ByteArray, input: ByteArray) = Mac.getInstance("HmacSHA256").run {
+            init(SecretKeySpec(key, "HmacSHA256")); doFinal(input)
+        }
+        val extracted = hmac(bytes("saltB64"), secret)
+        val key = try { hmac(extracted, context + byteArrayOf(1)) } finally { extracted.fill(0) }
+        return try { Cipher.getInstance("AES/GCM/NoPadding").run {
+            init(Cipher.DECRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(128, bytes("ivB64")))
+            updateAAD(context); doFinal(bytes("ciphertextB64"))
+        } }
+        finally { key.fill(0) }
+    }
+
+    private suspend fun chunkRequest(): ComboHistoryReadRequest {
+        val initial = request()
+        send(initial)
+        val page = Json.parseToJsonElement(open(initial).decodeToString()).jsonObject
+        assertThat(page.getValue("unscopedCorruptReads").jsonPrimitive.int).isEqualTo(2)
+        assertThat(page.getValue("reads").jsonArray.single().jsonObject.getValue("adverse").jsonPrimitive.boolean).isTrue()
+        return request(buildJsonObject {
+            put("kind", "chunk"); put("snapshotId", page.getValue("snapshotId"))
+            put("readId", reader.id); put("pumpBinding", reader.pumpBinding); put("sha256", reader.hash)
+            put("totalBytes", reader.raw.size); put("offset", 0); put("length", reader.raw.size)
+        })
+    }
+
+    private suspend fun refused(block: suspend () -> Unit) {
+        var failure: Exception? = null
+        val before = sent.size
+        try { block() } catch (e: Exception) { failure = e }
+        assertThat(failure?.message).isEqualTo("combo_history_unavailable")
+        assertThat(failure?.cause).isNull()
+        assertThat(sent).hasSize(before)
+    }
+
+    @Test fun inventoryAndExactFragmentUseOriginalBytesAndKeepAdverseEvidence() = runTest {
