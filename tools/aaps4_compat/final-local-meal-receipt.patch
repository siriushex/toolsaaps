diff --git a/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalMealRecordTest.kt b/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalMealRecordTest.kt
new file mode 100644
index 0000000000..d52d7cbfc5
--- /dev/null
+++ b/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalMealRecordTest.kt
@@ -0,0 +1,44 @@
+package app.aaps.database
+
+import app.aaps.database.di.JvmAppDatabaseBuilder
+import app.aaps.database.entities.Carbs
+import kotlinx.coroutines.test.runTest
+import kotlin.io.path.createTempDirectory
+import kotlin.test.AfterTest
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class LocalMealRecordTest {
+    private val dir = createTempDirectory("meal-record-test")
+    private val db = JvmAppDatabaseBuilder().provideAppDatabase("$dir/test.db")
+    private val dao = db.carbsDao
+    private val marker = "copilot:manual:meal:test-entry"
+    private val meal = Carbs(timestamp = 100_000, duration = 0, amount = 12.25, notes = marker)
+    private suspend fun matched() = dao.matchesLocalMeal(marker, meal.timestamp, meal.amount)
+
+    @AfterTest fun close() {
+        db.close()
+        dir.toFile().deleteRecursively()
+    }
+
+    @Test fun exactCurrentRowOnly() = runTest {
+        dao.insert(meal.copy(notes = "other"))
+        assertFalse(matched())
+        val id = dao.insert(meal.copy())
+        dao.insert(meal.copy(referenceId = id, version = 1, isValid = false))
+        assertTrue(matched())
+        assertFalse(dao.matchesLocalMeal(marker, meal.timestamp + 1, meal.amount))
+        assertFalse(dao.matchesLocalMeal(marker, meal.timestamp, 12.0))
+        dao.insert(meal.copy(timestamp = meal.timestamp + 1, isValid = false))
+        assertFalse(matched())
+    }
+
+    @Test fun invalidOrExtendedRecordDoesNotConfirmImmediateMeal() = runTest {
+        dao.insert(meal.copy(isValid = false))
+        assertFalse(matched())
+        val extended = "copilot:manual:meal:extended"
+        dao.insert(meal.copy(notes = extended, duration = 60_000))
+        assertFalse(dao.matchesLocalMeal(extended, meal.timestamp, meal.amount))
+    }
+}
