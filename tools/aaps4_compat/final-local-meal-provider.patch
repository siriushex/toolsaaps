@@ -236,2 +244,49 @@ class AuthorizedClientsRepository(

+    /** Validate one explicit meal on this master. A preview never writes carbs or delivers insulin. */
+    suspend fun previewLocalMeal(master: String, request: SignedEnvelope, executor: MasterActionExecutor,
+                                 clock: () -> Long): AckEnvelope? {
+        fun live() = preferences.hardenedMode && master.isNotBlank() &&
+            preferences.get(StringNonKey.NsClientControlOwnInstallId) == master &&
+            request.timestamp > 0 && request.validUntil > request.timestamp &&
+            request.validUntil - request.timestamp == 8_000L && clock() in request.timestamp until request.validUntil
+        if (request.type != "batch_prepare" || !request.wantsAck || !live()) return null
+        val msg = Json.decodeFromString(ClientControlMessage.serializer(), request.payload) as? ClientControlMessage.BatchPrepare ?: return null
+        val one = msg.actions.singleOrNull() ?: return null
+        if (one.carbs !in 1..120 || !Regex("copilot:manual:meal:[A-Za-z0-9_-]{1,80}").matches(one.notes) ||
+            one != BatchActionDto(type = BatchActionDto.TYPE_BOLUS, carbs = one.carbs, notes = one.notes) ||
+            Json.encodeToString(ClientControlMessage.serializer(), msg) != request.payload) return null
+        val action = one.toDomain() ?: return null
+        val (owner, role) = mutex.withLock {
+            val list = decode()
+            val entry = list.singleOrNull { it.clientId == request.clientId } ?: return null
+            val role = ClientRole.entries.singleOrNull { it.name == entry.role } ?: return null
+            if (!entry.localCopilot || entry.state != ClientState.Active || entry.pendingSecret != null ||
+                !role.allows(ClientRole.MealAssistant) || entry.counterReceived < 2 || request.counter <= entry.counterReceived ||
+                request.timestamp < entry.lastSeenAt || !secureEncrypt.isValidDataString(entry.encryptedSecret)) return null
+            val key = ClientControlCrypto.hexToBytes(secureEncrypt.decrypt(entry.encryptedSecret))
+            val verified = try { key.size == 32 && ClientControlCrypto.verifyEnvelope(key, request) } finally { key.fill(0) }
+            if (!verified || !live()) return null
+            val next = entry.copy(counterReceived = request.counter, lastSeenAt = clock())
+            write(list.map { if (it == entry) next else it })
+            next to role
+        }
+        val preview = executor.prepareBatch(listOf(action), RemoteCaller(owner.clientId, role)) as? MasterActionExecutor.PrepareResult.Preview ?: return null
+        try {
+            if (preview.bolusId <= 0 || preview.insulin != 0.0 || preview.carbs != one.carbs ||
+                preview.advisorApplies || preview.advisorLines.isNotEmpty()) return null
+            return mutex.withLock {
+                if (!live() || decode().singleOrNull { it.clientId == owner.clientId } != owner) return@withLock null
+                val lines = preview.lines.map { app.aaps.core.nssdk.localmodel.clientcontrol.ConfirmationLineDto(it.role.name, it.text) }
+                val body = BolusPreview(preview.bolusId, lines, manualMeal = ManualMealPreviewDto(one.notes, preview.carbs, 0.0))
+                val key = ClientControlCrypto.hexToBytes(secureEncrypt.decrypt(owner.encryptedSecret))
+                try {
+                    val at = clock()
+                    if (key.size != 32 || at !in request.timestamp until request.validUntil) return@withLock null
+                    ClientControlCrypto.signAck(key, AckEnvelope(owner.clientId, request.counter, AckPhase.Done, AckStatus.Ok,
+                        payload = Json.encodeToString(BolusPreview.serializer(), body), timestamp = at, signature = ""))
+                } finally { key.fill(0) }
+            }
+        } finally { executor.discard(preview.bolusId) }
+    }
