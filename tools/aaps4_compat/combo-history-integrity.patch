+package info.nightscout.pump.combov2
+
+import info.nightscout.comboctl.base.HistoryReadCheckpoint
+import info.nightscout.comboctl.base.HistoryReadObservation
+import info.nightscout.comboctl.base.BluetoothAddress
+import info.nightscout.comboctl.base.InvariantPumpData
+import java.io.Closeable
+import java.io.ByteArrayInputStream
+import java.io.DataInputStream
+import java.io.File
+import java.io.IOException
+import java.io.RandomAccessFile
+import java.nio.channels.FileChannel
+import java.nio.channels.FileLock
+import java.nio.file.Files
+import java.nio.file.LinkOption.NOFOLLOW_LINKS
+import java.nio.file.StandardOpenOption.READ
+import java.util.UUID
+import java.util.Collections
+import java.util.zip.CRC32
+import java.security.MessageDigest
+import java.util.concurrent.ConcurrentHashMap
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+internal fun comboHistoryBinding(address: BluetoothAddress, data: InvariantPumpData): String =
+    MessageDigest.getInstance("SHA-256").digest(
+        "history-v1|$address|${data.clientPumpCipher}|${data.pumpClientCipher}|${data.keyResponseAddress}".toByteArray(Charsets.UTF_8)
+    ).joinToString("") { "%02x".format(it.toInt() and 255) }
+
+/** Private, bounded evidence only. Neither a closed file nor fsync proves delivery coverage. */
+internal class ComboHistoryJournal(
+    private val directory: File,
+    private val maxBytes: Long = 32L * 1024 * 1024,
+    private val maxReads: Int = 4096,
+    private val sync: (RandomAccessFile) -> Unit = { it.fd.sync() }
+) : Closeable {
+    private data class Entry(val binding: String?, var closed: Boolean, val corrupt: Boolean, var adverse: Boolean = false, var readFailed: Boolean = false)
+    private val entries = mutableListOf<Entry>()
+    private var lockFile: RandomAccessFile? = null
+    private var lock: FileLock? = null
+    private var activeFile: File? = null
+    private var activeEntry: Entry? = null
+    private var previousPhase: HistoryReadCheckpoint.Phase? = null
+    private var bytes = 0L
+    private var activeRecords = 0
+    private var failed = false
+    private var claimedPath: String? = null
+    private var currentSnapshot: Snapshot? = null
+
+    internal class RetainedRead internal constructor(
+        val id: String, val size: Int, val sha256: String,
+        val closed: Boolean, val corrupt: Boolean, val adverse: Boolean, val readFailed: Boolean
+    ) {
+        override fun toString() = "RetainedRead(redacted)"
+    }
+
+    internal class Snapshot internal constructor(reads: List<RetainedRead>, val unscopedCorruptReads: Int, val writerFailed: Boolean) {
+        val reads: List<RetainedRead> = Collections.unmodifiableList(ArrayList(reads))
+        val coverage = "unverified"
+        override fun toString() = "HistorySnapshot(redacted)"
+    }
+
+    internal class Chunk internal constructor(val offset: Int, val totalSize: Int, val sha256: String, bytes: ByteArray) {
+        private val content = bytes.copyOf()
+        val endOfRead get() = offset + content.size == totalSize
+        fun bytes(): ByteArray = content.copyOf()
+        override fun toString() = "HistoryChunk(redacted)"
+    }
+
+    init {
+        try {
+            require(maxBytes > 0 && maxReads > 0)
+            val created = !directory.exists()
+            if (created && !directory.mkdir()) throw IOException("History directory unavailable")
+            require(directory.isDirectory && !Files.isSymbolicLink(directory.toPath()))
+            if (created) FileChannel.open(checkNotNull(directory.parentFile).toPath(), READ).use { it.force(true) }
+            val path = directory.canonicalPath
+            check(OPEN_WRITERS.putIfAbsent(path, this) == null)
+            claimedPath = path
+            val lockPath = File(directory, "writer.lock")
+            require(!lockPath.exists() || Files.isRegularFile(lockPath.toPath(), NOFOLLOW_LINKS))
+            require(!Files.isSymbolicLink(lockPath.toPath()))
+            lockFile = RandomAccessFile(lockPath, "rw")
+            lock = lockFile!!.channel.tryLock() ?: throw IOException("History writer already active")
+            val files = directory.listFiles() ?: throw IOException("History directory unreadable")
+            require(files.size <= maxReads + 1)
+            for (file in files) {
+                if (file.name == "writer.lock") continue
+                require(file.name.matches(Regex("[0-9a-f-]{36}\\.chr")) && Files.isRegularFile(file.toPath(), NOFOLLOW_LINKS))
+                bytes += file.length()
+                require(bytes <= maxBytes)
+                entries += recover(file)
+            }
+        } catch (e: Exception) {
+            failed = true
+            releaseLock()
+            throw IOException("History journal unavailable")
+        }
+    }
+
+    @Synchronized
+    fun record(binding: String, checkpoint: HistoryReadCheckpoint) {
+        currentSnapshot = null
+        try {
+            check(!failed && lock?.isValid == true)
+            require(binding.matches(Regex("[0-9a-f]{64}")))
+            require(checkpoint.payload.size <= 4096)
+            val phase = checkpoint.phase
+            if (phase == HistoryReadCheckpoint.Phase.BEGIN) {
+                require(entries.size < maxReads)
+                previousPhase = null
+                activeRecords = 0
+            } else {
+                require(activeEntry?.binding == binding)
+            }
+            validateTransition(previousPhase, phase)
+            require(activeRecords < 256)
+            require(if (phase == HistoryReadCheckpoint.Phase.END)
+                checkpoint.observation.state in setOf(HistoryReadObservation.State.RETURNED, HistoryReadObservation.State.FAILED)
+            else checkpoint.observation.state == HistoryReadObservation.State.READING)
+            require((phase == HistoryReadCheckpoint.Phase.BLOCK) == checkpoint.payload.isNotEmpty())
+            val body = buildJsonObject {
+                put("version", 1)
+                put("binding", binding)
+                put("phase", phase.name)
+                put("observation", comboHistoryReadStatus(checkpoint.observation))
+                if (checkpoint.payload.isNotEmpty())
+                    put("payloadHex", checkpoint.payload.joinToString("") { "%02x".format(it.toInt() and 255) })
+            }.toString().toByteArray(Charsets.UTF_8)
+            require(body.size in 1..MAX_RECORD_BYTES && bytes + body.size + 8 <= maxBytes)
+            if (phase == HistoryReadCheckpoint.Phase.BEGIN) {
+                val file = File(directory, "${UUID.randomUUID()}.chr")
+                check(file.createNewFile())
+                activeFile = file
+                activeEntry = Entry(binding, false, false).also { entries += it }
+            }
+            val file = checkNotNull(activeFile)
+            require(file.length() + body.size + 8 <= MAX_READ_BYTES)
+            RandomAccessFile(file, "rw").use { out ->
+                out.seek(out.length())
+                out.writeInt(body.size)
+                out.write(body)
+                out.writeInt(checksum(body))
+                sync(out)
+            }
+            if (phase == HistoryReadCheckpoint.Phase.BEGIN)
+                FileChannel.open(directory.toPath(), READ).use { it.force(true) }
+            bytes += body.size + 8
+            activeRecords++
+            previousPhase = phase
+            activeEntry!!.adverse = activeEntry!!.adverse || adverse(comboHistoryReadStatus(checkpoint.observation))
+            activeEntry!!.readFailed = checkpoint.observation.state == HistoryReadObservation.State.FAILED
+            if (phase == HistoryReadCheckpoint.Phase.END) {
+                activeEntry!!.closed = true
+                activeFile = null
+                activeEntry = null
+            }
+        } catch (e: Exception) {
+            failed = true
+            throw IOException("History checkpoint not stored")
+        }
+    }
+
+    @Synchronized
+    fun status(binding: String): JsonObject = buildJsonObject {
+        val matching = entries.filter { it.binding == binding }
+        put("version", 1)
+        put("coverage", "unverified")
+        put("state", if (failed) "FAILED" else if (activeEntry != null) "WRITING" else "STORED")
+        put("retainedReads", matching.size)
+        put("unclosedReads", matching.count { !it.closed })
+        put("corruptReads", matching.count { it.corrupt })
+        put("adverseReads", matching.count { it.adverse || it.corrupt })
+        put("failedReads", matching.count { it.readFailed })
+        put("unscopedCorruptReads", entries.count { it.binding == null && it.corrupt })
+    }
+
+    /** Internal readout only: a snapshot is not transport authorization or clinical coverage. */
+    @Synchronized
+    fun snapshot(binding: String): Snapshot {
+        currentSnapshot = null
+        try {
+            require(binding.matches(Regex("[0-9a-f]{64}")))
+            check(lock?.isValid == true && (activeEntry == null || failed))
+            check(!Files.isSymbolicLink(directory.toPath()) && directory.canonicalPath == claimedPath)
+            val files = checkNotNull(directory.listFiles())
+            require(files.size <= maxReads + 1)
+            var totalBytes = 0L
+            var unscoped = 0
+            val reads = mutableListOf<RetainedRead>()
+            for (file in files.sortedBy { it.name }) {
+                if (file.name == "writer.lock") continue
+                require(file.extension == "chr" && UUID.fromString(file.nameWithoutExtension).toString() == file.nameWithoutExtension)
+                val raw = readRetainedBytes(file)
+                totalBytes += raw.size
+                require(totalBytes <= maxBytes)
+                // Scope, damage flags and digest must come from the same immutable bytes.
+                val entry = recover(file, raw)
+                if (entry.binding == null && entry.corrupt) unscoped++
+                if (entry.binding == binding) reads += RetainedRead(
+                    file.nameWithoutExtension, raw.size, digest(raw), entry.closed, entry.corrupt,
+                    entry.adverse || entry.corrupt, entry.readFailed
+                )
+            }
+            return Snapshot(reads, unscoped, failed).also { currentSnapshot = it }
+        } catch (e: Exception) {
+            throw IOException("History snapshot unavailable")
+        }
+    }
+
+    @Synchronized
+    fun readChunk(snapshot: Snapshot, readId: String, offset: Int, maxChunkBytes: Int): Chunk {
+        try {
+            check(currentSnapshot === snapshot && lock?.isValid == true)
+            check(!Files.isSymbolicLink(directory.toPath()) && directory.canonicalPath == claimedPath)
+            require(maxChunkBytes in 1..65536)
+            val read = checkNotNull(snapshot.reads.singleOrNull { it.id == readId })
+            require(offset in 0..read.size)
+            val raw = readRetainedBytes(File(directory, "${read.id}.chr"))
+            require(raw.size == read.size && digest(raw) == read.sha256)
+            val end = minOf(raw.size, offset + maxChunkBytes)
+            return Chunk(offset, read.size, read.sha256, raw.copyOfRange(offset, end))
+        } catch (e: Exception) {
+            currentSnapshot = null
+            throw IOException("History chunk unavailable")
+        }
+    }
+
+    private fun recover(file: File, raw: ByteArray? = null): Entry {
+        var binding: String? = null
+        return try {
+            var previous: HistoryReadCheckpoint.Phase? = null
+            var hasAdverse = false
+            var readFailed = false
+            scanRecords(raw ?: readRetainedBytes(file)) { record ->
+                require(record["version"]?.jsonPrimitive?.int == 1)
+                val owner = record.getValue("binding").jsonPrimitive.content
+                require(owner.matches(Regex("[0-9a-f]{64}")))
+                if (binding != null) require(binding == owner)
+                val phase = HistoryReadCheckpoint.Phase.valueOf(record.getValue("phase").jsonPrimitive.content)
+                validateTransition(previous, phase)
+                val hex = record["payloadHex"]?.jsonPrimitive?.content
+                require(if (phase == HistoryReadCheckpoint.Phase.BLOCK) hex != null && hex.matches(Regex("(?:[0-9a-f]{2}){1,4096}")) else hex == null)
+                val observation = record.getValue("observation").jsonObject
+                require(observation["coverage"] == JsonPrimitive("unverified"))
+                val state = HistoryReadObservation.State.valueOf(observation.getValue("state").jsonPrimitive.content)
+                require(if (phase == HistoryReadCheckpoint.Phase.END) state in setOf(HistoryReadObservation.State.RETURNED, HistoryReadObservation.State.FAILED) else state == HistoryReadObservation.State.READING)
+                // Retain only a validated prefix binding if a later frame is torn.
+                binding = owner
+                hasAdverse = hasAdverse || adverse(observation)
+                readFailed = state == HistoryReadObservation.State.FAILED
+                previous = phase
+            }
+            require(previous != null)
+            Entry(binding, previous == HistoryReadCheckpoint.Phase.END, false, hasAdverse, readFailed)
+        } catch (e: Exception) {
+            Entry(binding, false, true)
+        }
+    }
+
+    @Synchronized
+    override fun close() {
+        currentSnapshot = null
+        failed = true
+        releaseLock()
+    }
+
+    private fun releaseLock() {
+        try {
+            try { lock?.release() } finally { lock = null; lockFile?.close(); lockFile = null }
+        } finally {
+            claimedPath?.let { OPEN_WRITERS.remove(it, this) }
+            claimedPath = null
+        }
+    }
+
+    companion object {
+        private const val MAX_RECORD_BYTES = 16384
+        private const val MAX_READ_BYTES = 2L * 1024 * 1024
+        // Do not open/close a second descriptor for a lock held by this JVM.
+        private val OPEN_WRITERS = ConcurrentHashMap<String, ComboHistoryJournal>()
+
+        private fun checksum(bytes: ByteArray) = CRC32().apply { update(bytes) }.value.toInt()
+
+        private fun digest(bytes: ByteArray) = MessageDigest.getInstance("SHA-256").digest(bytes)
+            .joinToString("") { "%02x".format(it.toInt() and 255) }
+
+        private fun adverse(observation: JsonObject) = listOf(
+            "gapObserved", "clockChangeObserved", "unmappedEventObserved", "interruptedReadObserved", "malformedBlockObserved", "journalWriteFailed"
+        ).any { observation[it] == JsonPrimitive(true) }
+
+        private fun validateTransition(previous: HistoryReadCheckpoint.Phase?, next: HistoryReadCheckpoint.Phase) {
+            val valid = when (next) {
+                HistoryReadCheckpoint.Phase.BEGIN -> previous == null
+                HistoryReadCheckpoint.Phase.BLOCK -> previous in setOf(HistoryReadCheckpoint.Phase.BEGIN, HistoryReadCheckpoint.Phase.CONFIRMED)
+                HistoryReadCheckpoint.Phase.CONFIRMED -> previous == HistoryReadCheckpoint.Phase.BLOCK
+                HistoryReadCheckpoint.Phase.END -> previous != null && previous != HistoryReadCheckpoint.Phase.END
+            }
+            require(valid)
+        }
+
+        internal fun readRecords(file: File): List<JsonObject> = buildList {
+            scanRecords(readRetainedBytes(file)) { add(it) }
+        }
+
+        private fun readRetainedBytes(file: File): ByteArray {
+            require(file.length() <= MAX_READ_BYTES && Files.isRegularFile(file.toPath(), NOFOLLOW_LINKS))
+            Files.newByteChannel(file.toPath(), setOf(READ, NOFOLLOW_LINKS)).use { input ->
+                val size = input.size()
+                require(size in 0..MAX_READ_BYTES)
+                val buffer = java.nio.ByteBuffer.allocate(size.toInt())
+                while (buffer.hasRemaining()) check(input.read(buffer) > 0)
+                check(input.size() == size && input.read(java.nio.ByteBuffer.allocate(1)) == -1)
+                return buffer.array()
+            }
+        }
+
+        private fun scanRecords(raw: ByteArray, onRecord: (JsonObject) -> Unit) {
+            require(raw.size <= MAX_READ_BYTES)
+            DataInputStream(ByteArrayInputStream(raw)).use { input ->
+                var records = 0
+                while (input.available() > 0) {
+                    require(records < 256)
+                    val length = input.readInt()
+                    require(length in 1..MAX_RECORD_BYTES && input.available() >= length + 4)
+                    val bytes = ByteArray(length)
+                    input.readFully(bytes)
+                    require(input.readInt() == checksum(bytes))
+                    onRecord(Json.parseToJsonElement(bytes.toString(Charsets.UTF_8)).jsonObject)
+                    records++
+                }
+            }
+        }
+    }
+}
