+package info.nightscout.comboctl.base
+
+/** Session-local diagnostics, never a receipt of durable or complete insulin delivery. */
+data class HistoryReadObservation(
+    val state: State = State.NOT_READ,
+    val readStartedAtEpochMs: Long? = null,
+    val readFinishedAtEpochMs: Long? = null,
+    val validatedBlocks: Int = 0,
+    val confirmedBlocks: Int = 0,
+    val parsedEvents: Int = 0,
+    val unmappedEvents: Int = 0,
+    val gapObserved: Boolean = false,
+    val clockChangeObserved: Boolean = false,
+    val unmappedEventObserved: Boolean = false,
+    val interruptedReadObserved: Boolean = false,
+    val malformedBlockObserved: Boolean = false,
+    val journalWriteFailed: Boolean = false
+) {
+    enum class State { NOT_READ, READING, RETURNED, FAILED }
+}
