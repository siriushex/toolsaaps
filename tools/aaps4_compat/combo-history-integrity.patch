+package info.nightscout.pump.combov2
+
+import info.nightscout.comboctl.base.HistoryReadCheckpoint
+import info.nightscout.comboctl.base.HistoryReadCheckpoint.Phase
+import info.nightscout.comboctl.base.HistoryReadObservation
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.IOException
+import java.io.RandomAccessFile
+import java.nio.file.Files
+import java.security.MessageDigest
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ComboHistoryReadoutTest {
+    @TempDir lateinit var root: File
+    private val directory get() = File(root, "history")
+    private val binding = "a".repeat(64)
+    private val other = "b".repeat(64)
+    private fun checkpoint(phase: Phase, payload: List<Byte> = emptyList()) = HistoryReadCheckpoint(
+        phase, HistoryReadObservation(
+            state = if (phase == Phase.END) HistoryReadObservation.State.RETURNED else HistoryReadObservation.State.READING,
+            readStartedAtEpochMs = 1000, readFinishedAtEpochMs = if (phase == Phase.END) 900 else null,
+            gapObserved = true, clockChangeObserved = true, unmappedEventObserved = true
+        ), payload
+    )
+
+    private fun complete(journal: ComboHistoryJournal, owner: String = binding, blocks: Int = 1) {
+        journal.record(owner, checkpoint(Phase.BEGIN))
+        repeat(blocks) {
+            journal.record(owner, checkpoint(Phase.BLOCK, List(4096) { (it % 256).toByte() }))
+            journal.record(owner, checkpoint(Phase.CONFIRMED))
+        }
+        journal.record(owner, checkpoint(Phase.END))
+    }
+
+    private fun readAll(journal: ComboHistoryJournal, snapshot: ComboHistoryJournal.Snapshot, id: String): ByteArray {
+        val out = ByteArrayOutputStream()
+        do {
+            val chunk = journal.readChunk(snapshot, id, out.size(), 65536)
+            assertTrue(chunk.bytes().size <= 65536)
+            out.write(chunk.bytes())
+        } while (!chunk.endOfRead)
+        return out.toByteArray()
+    }
