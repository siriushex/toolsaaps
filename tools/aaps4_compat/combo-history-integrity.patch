@@ -0,0 +1,214 @@
+package info.nightscout.pump.combov2
+
+import info.nightscout.comboctl.base.HistoryReadCheckpoint
+import info.nightscout.comboctl.base.HistoryReadCheckpoint.Phase
+import info.nightscout.comboctl.base.HistoryReadObservation
+import info.nightscout.comboctl.base.toBluetoothAddress
+import java.io.File
+import java.io.IOException
+import java.io.RandomAccessFile
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonObject
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+
+class ComboHistoryJournalTest {
+    @TempDir lateinit var root: File
+    private val binding = "a".repeat(64)
+    private val directory get() = File(root, "history")
+    private fun checkpoint(phase: Phase) = HistoryReadCheckpoint(
+        phase,
+        HistoryReadObservation(
+            state = if (phase == Phase.END) HistoryReadObservation.State.RETURNED else HistoryReadObservation.State.READING,
+            readStartedAtEpochMs = 1000, readFinishedAtEpochMs = if (phase == Phase.END) 900 else null,
+            validatedBlocks = if (phase == Phase.BEGIN) 0 else 1,
+            confirmedBlocks = if (phase in setOf(Phase.CONFIRMED, Phase.END)) 1 else 0,
+            gapObserved = true
+        ),
+        if (phase == Phase.BLOCK) listOf(0, 0, 0, 0, 0xb7.toByte(), 0x48, 0) else emptyList()
+    )
+
+    @Test fun successfulReadSurvivesReopenWithRawPayloadAndBackwardsDeviceClock() {
+        var syncs = 0
+        ComboHistoryJournal(directory, sync = { it.fd.sync(); syncs++ }).use { journal ->
+            Phase.entries.forEach { journal.record(binding, checkpoint(it)) }
+        }
+        assertEquals(4, syncs)
+        val records = ComboHistoryJournal.readRecords(directory.listFiles()!!.single { it.extension == "chr" })
+        assertEquals(JsonPrimitive("00000000b74800"), records[1]["payloadHex"])
+        assertEquals(JsonPrimitive(900), records.last().getValue("observation").jsonObject["readFinishedAt"])
+        ComboHistoryJournal(directory).use { journal ->
+            assertEquals(JsonPrimitive(1), journal.status(binding)["retainedReads"])
+            assertEquals(JsonPrimitive(0), journal.status(binding)["unclosedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["adverseReads"])
+            assertEquals(JsonPrimitive("unverified"), journal.status(binding)["coverage"])
+            assertEquals(JsonPrimitive(0), journal.status("b".repeat(64))["retainedReads"])
+        }
+    }
+
+    @Test fun interruptedReadRemainsUnclosedAfterNewCleanRead() {
+        ComboHistoryJournal(directory).use { journal ->
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            journal.record(binding, checkpoint(Phase.BLOCK))
+        }
+        ComboHistoryJournal(directory).use { journal ->
+            Phase.entries.forEach { journal.record(binding, checkpoint(it)) }
+            assertEquals(JsonPrimitive(1), journal.status(binding)["unclosedReads"])
+            assertEquals(JsonPrimitive(2), journal.status(binding)["retainedReads"])
+        }
+    }
+
+    @Test fun tornTailIsPreservedNotRepaired() {
+        ComboHistoryJournal(directory).use { journal -> Phase.entries.forEach { journal.record(binding, checkpoint(it)) } }
+        val file = directory.listFiles()!!.single { it.extension == "chr" }
+        RandomAccessFile(file, "rw").use { it.setLength(it.length() - 1) }
+        val before = file.readBytes()
+        ComboHistoryJournal(directory).use { journal ->
+            assertEquals(JsonPrimitive(1), journal.status(binding)["corruptReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["unclosedReads"])
+        }
+        assertArrayEquals(before, file.readBytes())
+    }
+
+    @Test fun checksumCorruptionIsDetectedEvenWithUnchangedLength() {
+        ComboHistoryJournal(directory).use { journal -> Phase.entries.forEach { journal.record(binding, checkpoint(it)) } }
+        val file = directory.listFiles()!!.single { it.extension == "chr" }
+        RandomAccessFile(file, "rw").use { it.seek(10); it.writeByte(0) }
+        val before = file.readBytes()
+        ComboHistoryJournal(directory).use { journal ->
+            for (owner in listOf(binding, "b".repeat(64))) {
+                assertEquals(JsonPrimitive(0), journal.status(owner)["retainedReads"])
+                assertEquals(JsonPrimitive(0), journal.status(owner)["corruptReads"])
+                assertEquals(JsonPrimitive(1), journal.status(owner)["unscopedCorruptReads"])
+            }
+        }
+        assertArrayEquals(before, file.readBytes())
+    }
+
+    @Test fun tornTailBindingCannotContaminateAnotherPairingAfterReopen() {
+        ComboHistoryJournal(directory).use { journal -> Phase.entries.forEach { journal.record(binding, checkpoint(it)) } }
+        val file = directory.listFiles()!!.single { it.extension == "chr" }
+        RandomAccessFile(file, "rw").use { it.setLength(it.length() - 1) }
+        val before = file.readBytes()
+        val other = "b".repeat(64)
+        ComboHistoryJournal(directory).use { journal ->
+            Phase.entries.forEach { journal.record(other, checkpoint(it)) }
+        }
+        ComboHistoryJournal(directory).use { journal ->
+            assertEquals(JsonPrimitive(1), journal.status(binding)["retainedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["corruptReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["unclosedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(other)["retainedReads"])
+            assertEquals(JsonPrimitive(0), journal.status(other)["corruptReads"])
+            assertEquals(JsonPrimitive(0), journal.status(other)["unclosedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(other)["adverseReads"])
+            assertEquals(JsonPrimitive(0), journal.status(other)["unscopedCorruptReads"])
+        }
+        assertArrayEquals(before, file.readBytes())
+    }
+
+    @Test fun invalidBeginCannotSupplyAPairingBindingEvenWithValidChecksum() {
+        ComboHistoryJournal(directory).use { it.record(binding, checkpoint(Phase.BEGIN)) }
+        val file = directory.listFiles()!!.single { it.extension == "chr" }
+        val original = ComboHistoryJournal.readRecords(file).single()
+        val observation = kotlinx.serialization.json.JsonObject(original.getValue("observation").jsonObject +
+            ("state" to JsonPrimitive("RETURNED")))
+        val body = kotlinx.serialization.json.JsonObject(original + ("observation" to observation))
+            .toString().toByteArray(Charsets.UTF_8)
+        RandomAccessFile(file, "rw").use {
+            it.setLength(0)
+            it.writeInt(body.size)
+            it.write(body)
+            it.writeInt(java.util.zip.CRC32().apply { update(body) }.value.toInt())
+        }
+        val before = file.readBytes()
+        ComboHistoryJournal(directory).use { journal ->
+            assertEquals(JsonPrimitive(0), journal.status(binding)["retainedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["unscopedCorruptReads"])
+        }
+        assertArrayEquals(before, file.readBytes())
+    }
+
+    @Test fun byteLimitAndInvalidPhaseCannotBeSilentlyAccepted() {
+        ComboHistoryJournal(directory, maxBytes = 16).use { journal ->
+            assertThrows(IOException::class.java) { journal.record(binding, checkpoint(Phase.BEGIN)) }
+            assertEquals(0, directory.listFiles()!!.count { it.extension == "chr" })
+        }
+        ComboHistoryJournal(directory).use { journal ->
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            assertThrows(IOException::class.java) { journal.record(binding, checkpoint(Phase.CONFIRMED)) }
+        }
+    }
+
+    @Test fun closedFailedReadStillCarriesFailureAndInterruptedEvidence() {
+        ComboHistoryJournal(directory).use { journal ->
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            journal.record(binding, HistoryReadCheckpoint(Phase.END, HistoryReadObservation(
+                state = HistoryReadObservation.State.FAILED, interruptedReadObserved = true
+            )))
+        }
+        ComboHistoryJournal(directory).use { journal ->
+            assertEquals(JsonPrimitive(1), journal.status(binding)["failedReads"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["adverseReads"])
+            assertEquals(JsonPrimitive("unverified"), journal.status(binding)["coverage"])
+        }
+    }
+
+    @Test fun secondWriterCannotUseSameDirectory() {
+        ComboHistoryJournal(directory).use { journal ->
+            assertThrows(IOException::class.java) { ComboHistoryJournal(directory) }
+            assertThrows(IOException::class.java) { ComboHistoryJournal(directory) }
+            journal.record(binding, checkpoint(Phase.BEGIN))
+        }
+        ComboHistoryJournal(directory).close()
+    }
+
+    @Test fun differentPairingMaterialCannotReuseThePreviousBinding() {
+        val address = "12:34:56:78:9A:BC".toBluetoothAddress()
+        val first = info.nightscout.comboctl.base.InvariantPumpData(
+            clientPumpCipher = info.nightscout.comboctl.base.Cipher(ByteArray(16) { 1 }),
+            pumpClientCipher = info.nightscout.comboctl.base.Cipher(ByteArray(16) { 2 }),
+            keyResponseAddress = 16, pumpID = "synthetic-pump"
+        )
+        val second = first.copy(clientPumpCipher = info.nightscout.comboctl.base.Cipher(ByteArray(16) { 3 }))
+        assertNotEquals(comboHistoryBinding(address, first), comboHistoryBinding(address, second))
+        assertEquals(comboHistoryBinding(address, first), comboHistoryBinding(address, first))
+    }
+
+    @Test fun capacityRefusesWithoutDeletingEarlierEvidence() {
+        ComboHistoryJournal(directory, maxReads = 1).use { journal ->
+            Phase.entries.forEach { journal.record(binding, checkpoint(it)) }
+            val before = directory.listFiles()!!.single { it.extension == "chr" }.readBytes()
+            assertThrows(IOException::class.java) { journal.record(binding, checkpoint(Phase.BEGIN)) }
+            assertEquals(JsonPrimitive("FAILED"), journal.status(binding)["state"])
+            assertArrayEquals(before, directory.listFiles()!!.single { it.extension == "chr" }.readBytes())
+        }
+    }
+
+    @Test fun syncFailureCannotAdvanceInMemoryStateOrResumeWriting() {
+        var writes = 0
+        ComboHistoryJournal(directory, sync = { if (++writes == 2) throw IOException("synthetic") else it.fd.sync() }).use { journal ->
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            assertThrows(IOException::class.java) { journal.record(binding, checkpoint(Phase.BLOCK)) }
+            assertThrows(IOException::class.java) { journal.record(binding, checkpoint(Phase.CONFIRMED)) }
+            assertEquals(2, writes)
+            assertEquals(JsonPrimitive("FAILED"), journal.status(binding)["state"])
+            assertEquals(JsonPrimitive(1), journal.status(binding)["unclosedReads"])
+        }
+    }
+
+    @Test fun bindingChangeWithinReadIsRejected() {
+        ComboHistoryJournal(directory).use { journal ->
+            journal.record(binding, checkpoint(Phase.BEGIN))
+            assertThrows(IOException::class.java) { journal.record("b".repeat(64), checkpoint(Phase.BLOCK)) }
+        }
+    }
+
+    @Test fun symlinkDirectoryIsRejectedWithoutTouchingDestination() {
+        val target = File(root, "other").also { it.mkdir() }
+        java.nio.file.Files.createSymbolicLink(directory.toPath(), target.toPath())
+        assertThrows(IOException::class.java) { ComboHistoryJournal(directory) }
+        assertEquals(0, target.listFiles()!!.size)
+    }
+}
