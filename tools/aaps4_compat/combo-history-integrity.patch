+package info.nightscout.pump.combov2
+
+import info.nightscout.comboctl.base.HistoryReadObservation
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+internal fun comboHistoryReadStatus(observation: HistoryReadObservation) = buildJsonObject {
+    put("version", 1)
+    put("scope", "reader_session")
+    put("coverage", "unverified")
+    put("state", observation.state.name)
+    observation.readStartedAtEpochMs?.let { put("readStartedAt", it) }
+    observation.readFinishedAtEpochMs?.let { put("readFinishedAt", it) }
+    put("validatedBlocks", observation.validatedBlocks)
+    put("confirmedBlocks", observation.confirmedBlocks)
+    put("parsedEvents", observation.parsedEvents)
+    put("unmappedEvents", observation.unmappedEvents)
+    put("gapObserved", observation.gapObserved)
+    put("clockChangeObserved", observation.clockChangeObserved)
+    put("unmappedEventObserved", observation.unmappedEventObserved)
+    put("interruptedReadObserved", observation.interruptedReadObserved)
+    put("malformedBlockObserved", observation.malformedBlockObserved)
+}
