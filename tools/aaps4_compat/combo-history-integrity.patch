+    @Synchronized
+    private fun storeHistoryCheckpoint(event: ComboCtlPump.Event.HistoryCheckpoint) {
+        // Keep the first scoped failure visible when later callbacks are refused.
+        if (historyJournalUnavailable) throw java.io.IOException("History checkpoint unavailable")
+        var binding: String? = null
+        try {
+            check(event.address == getBluetoothAddress())
+            val data = pumpStateStore.getInvariantPumpData(event.address)
+            binding = comboHistoryBinding(event.address, data)
+            val journal = historyJournal ?: ComboHistoryJournal(
+                java.io.File(context.noBackupFilesDir, "combo-history-v1")
+            ).also { historyJournal = it }
+            journal.record(binding, event.checkpoint)
+            lastHistoryJournal = Triple(event.address, binding, journal.status(binding))
+        } catch (e: Exception) {
+            historyJournalUnavailable = true
+            lastHistoryJournal = binding?.let { Triple(event.address, it, buildJsonObject {
+                put("version", 1)
+                put("coverage", "unverified")
+                put("state", "FAILED")
+            }) }
+            throw java.io.IOException("History checkpoint unavailable")
+        }
+    }
+
+    private fun currentHistoryJournalStatus(): JsonObject? {
+        val snapshot = lastHistoryJournal ?: return null
+        val address = getBluetoothAddress() ?: return null
+        if (snapshot.first != address) return null
+        return try {
+            snapshot.third.takeIf { snapshot.second == comboHistoryBinding(address, pumpStateStore.getInvariantPumpData(address)) }
+        } catch (e: Exception) { null }
+    }
+
