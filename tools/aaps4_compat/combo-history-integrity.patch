+    @Test fun retainedEvidenceHasBoundedReadOnlyAccessWithoutAnotherPumpReader() {
+        ComboHistoryJournal(directory).use { journal ->
+            complete(journal, blocks = 20)
+            val snapshot = journal.snapshot(binding)
+            val read = snapshot.reads.single()
+            val original = File(directory, "${read.id}.chr").readBytes()
+            assertTrue(original.size > 65536)
+            assertEquals("unverified", snapshot.coverage)
+            assertTrue(read.closed && read.adverse && !read.corrupt && !read.readFailed)
+            assertFalse(snapshot.writerFailed)
+            assertEquals(original.size, read.size)
+            assertEquals(MessageDigest.getInstance("SHA-256").digest(original).joinToString("") { "%02x".format(it.toInt() and 255) }, read.sha256)
+            assertArrayEquals(original, readAll(journal, snapshot, read.id))
+            assertArrayEquals(original, File(directory, "${read.id}.chr").readBytes())
+            val eof = journal.readChunk(snapshot, read.id, original.size, 1)
+            assertTrue(eof.endOfRead)
+            assertEquals(0, eof.bytes().size)
+        }
+    }
