+package info.nightscout.pump.combov2
+
+import info.nightscout.comboctl.base.HistoryReadObservation
+import kotlinx.serialization.json.JsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Test
+
+class ComboHistoryReadStatusTest {
+    @Test fun everyStateExplicitlyRemainsSessionLocalAndUnverified() {
+        for (state in HistoryReadObservation.State.entries) {
+            val json = comboHistoryReadStatus(HistoryReadObservation(state = state))
+            assertEquals(JsonPrimitive("reader_session"), json["scope"])
+            assertEquals(JsonPrimitive("unverified"), json["coverage"])
+            assertEquals(JsonPrimitive(state.name), json["state"])
+            assertEquals(14, json.size)
+            assertFalse(json.containsKey("timestamp"))
+            assertFalse(json.containsKey("pumpId"))
+        }
+    }
+
+    @Test fun countsAndAdverseFlagsSurviveStatusComposition() {
+        val json = comboHistoryReadStatus(HistoryReadObservation(
+            state = HistoryReadObservation.State.FAILED, readStartedAtEpochMs = 1000, readFinishedAtEpochMs = 900,
+            validatedBlocks = 3, confirmedBlocks = 2,
+            parsedEvents = 7, unmappedEvents = 1, gapObserved = true, clockChangeObserved = true,
+            unmappedEventObserved = true, interruptedReadObserved = true, malformedBlockObserved = true, journalWriteFailed = true
+        ))
+        assertEquals(JsonPrimitive(3), json["validatedBlocks"])
+        assertEquals(JsonPrimitive(2), json["confirmedBlocks"])
+        assertEquals(JsonPrimitive(7), json["parsedEvents"])
+        assertEquals(JsonPrimitive(1), json["unmappedEvents"])
+        // Raw observation clocks retain backwards jumps; they do not map pump-event time.
+        assertEquals(JsonPrimitive(1000L), json["readStartedAt"])
+        assertEquals(JsonPrimitive(900L), json["readFinishedAt"])
+        for (key in listOf("gapObserved", "clockChangeObserved", "unmappedEventObserved", "interruptedReadObserved", "malformedBlockObserved", "journalWriteFailed"))
+            assertEquals(JsonPrimitive(true), json[key])
+    }
+}
