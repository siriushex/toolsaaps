+package info.nightscout.comboctl.base
+
+/** A checkpoint of the existing consuming reader, never proof of delivery coverage. */
+class HistoryReadCheckpoint(
+    val phase: Phase,
+    val observation: HistoryReadObservation,
+    payload: List<Byte> = emptyList()
+) {
+    val payload: List<Byte> = payload.toList()
+
+    enum class Phase { BEGIN, BLOCK, CONFIRMED, END }
+
+    override fun toString() = "HistoryReadCheckpoint(redacted)"
+}
