+    private suspend fun verifyIntervalProfileRetry(extended: Boolean, emulated: Boolean = false) {
+        val key = if (extended) NsclientLongKey.ExtendedBolusLastSyncedId else NsclientLongKey.TemporaryBasalLastSyncedId
+        var cursor = 0L
+        var revision = 1L
+        val eb = EB(id = 1, timestamp = 10000, amount = 2.0, duration = 3600000, isEmulatingTempBasal = emulated)
+        val tb = TB(id = 1, timestamp = 10000, type = TB.Type.NORMAL,
+            rate = 1.0, isAbsolute = true, duration = 3600000)
+        whenever(preferences.get(key)).thenAnswer { cursor }
+        doAnswer { cursor = it.getArgument(1); null }.whenever(preferences).put(eq(key), any())
+        whenever(persistenceLayer.getLastExtendedBolusId()).thenAnswer { revision }
+        whenever(persistenceLayer.getLastTemporaryBasalId()).thenAnswer { revision }
+        whenever(persistenceLayer.getNextSyncElementExtendedBolus(any())).thenAnswer {
+            if (cursor < revision) Pair(eb, eb.copy(id = revision)) else null
+        }
+        whenever(persistenceLayer.getNextSyncElementTemporaryBasal(any())).thenAnswer {
+            if (cursor < revision) Pair(tb, tb.copy(id = revision)) else null
+        }
+        whenever(nsAndroidClient.createTreatment(anyOrNull())).thenReturn(
+            CreateUpdateResponse(500, null), CreateUpdateResponse(201, "receipt-1"))
+        whenever(nsAndroidClient.updateTreatment(anyOrNull())).thenReturn(
+            CreateUpdateResponse(500, null), CreateUpdateResponse(200, "receipt-1"))
+        val selector = DataSyncSelectorV3(preferences, aapsLogger, dateUtil, profileFunction,
+            activePlugin, profileRepository, persistenceLayer, storeDataForDb, config, nsClientRepository) { sut }
+        suspend fun upload() {
+            if (extended) selector.processChangedExtendedBoluses() else selector.processChangedTemporaryBasals()
+        }
+
+        whenever(profileFunction.getProfile(10000)).thenReturn(null)
+        upload()
+        assertThat(cursor).isEqualTo(0L)
+        verify(nsAndroidClient, never()).createTreatment(anyOrNull())
+        whenever(profileFunction.getProfile(10000)).thenReturn(effectiveProfile)
+        upload()
+        assertThat(cursor).isEqualTo(0L)
+        upload()
+        assertThat(cursor).isEqualTo(1L)
+        verify(nsAndroidClient, times(2)).createTreatment(anyOrNull())
+
+        revision = 2L
+        eb.isValid = false
+        tb.isValid = false
+        clearInvocations(nsAndroidClient)
+        whenever(profileFunction.getProfile(10000)).thenReturn(null)
+        upload()
+        assertThat(cursor).isEqualTo(1L)
