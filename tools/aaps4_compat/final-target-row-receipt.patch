@@ -0,0 +1,16 @@
+package app.aaps.database
+
+/** Cross-reference for an NSClient target audit entry. Not proof of client authorization. */
+object LocalTargetReceipt {
+    private val markerPattern = Regex("copilot:(?:TargetManager\\.v1:[0-9a-f]{32}|manual:meal:[A-Za-z0-9_-]{1,80}:eating-soon)")
+    private const val PREFIX = "target-row:"
+
+    fun validMarker(marker: String) = markerPattern.matches(marker)
+    fun link(marker: String?, id: Long): String? =
+        if (id > 0 && marker != null && validMarker(marker)) PREFIX + id else null
+
+    internal fun linkedId(values: List<String>): Long? {
+        val value = values.singleOrNull { it.startsWith(PREFIX) } ?: return null
+        return value.removePrefix(PREFIX).toLongOrNull()?.takeIf { it > 0 && value == PREFIX + it }
+    }
+}
diff --git a/database/impl/src/commonMain/kotlin/app/aaps/database/daos/TemporaryTargetDao.kt b/database/impl/src/commonMain/kotlin/app/aaps/database/daos/TemporaryTargetDao.kt
