@@ -4,2 +4,7 @@ import androidx.room.Dao
 import androidx.room.Query
+import androidx.room.Transaction
+import app.aaps.database.LocalTargetReceipt
+import app.aaps.database.entities.TABLE_USER_ENTRY
+import app.aaps.database.entities.UserEntry
+import app.aaps.database.entities.ValueWithUnit
 import app.aaps.database.entities.TABLE_TEMPORARY_TARGETS
@@ -10,2 +15,18 @@ internal interface TemporaryTargetDao : TraceableDao<TemporaryTarget> {

+    @Query("SELECT * FROM $TABLE_USER_ENTRY WHERE timestamp BETWEEN :issued AND :auditThrough " +
+        "AND action = 'TT' AND source = 'NSClient' AND note = :marker LIMIT 2")
+    suspend fun receiptEntries(marker: String, issued: Long, auditThrough: Long): List<UserEntry>
+
+    @Transaction
+    suspend fun recordedTarget(marker: String, issued: Long, observed: Long, mgdl: Double, minutes: Int,
+                               reason: TemporaryTarget.Reason): TemporaryTarget? {
+        if (!LocalTargetReceipt.validMarker(marker) || issued <= 0 || issued > Long.MAX_VALUE - 13_000L ||
+            observed < issued || !mgdl.isFinite() || mgdl <= 0 || minutes !in 1..1440) return null
+        val audit = receiptEntries(marker, issued, minOf(observed, issued + 13_000L)).singleOrNull() ?: return null
+        val id = LocalTargetReceipt.linkedId(audit.values.filterIsInstance<ValueWithUnit.SimpleString>().map { it.value }) ?: return null
+        return findById(id)?.takeIf { it.isValid && it.referenceId == null && it.timestamp in issued until issued + 8_000L &&
+            it.timestamp <= audit.timestamp && it.reason == reason && it.lowTarget == mgdl && it.highTarget == mgdl &&
+            it.duration == minutes * 60_000L }
+    }
+
     @Query("SELECT * FROM $TABLE_TEMPORARY_TARGETS WHERE id = :id")
diff --git a/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalTargetReceiptTest.kt b/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalTargetReceiptTest.kt
new file mode 100644
index 0000000000..f29ed0f4e7
--- /dev/null
+++ b/database/impl/src/jvmTest/kotlin/app/aaps/database/LocalTargetReceiptTest.kt
@@ -0,0 +1,75 @@
+package app.aaps.database
+
+import app.aaps.database.di.JvmAppDatabaseBuilder
+import app.aaps.database.entities.TemporaryTarget
+import app.aaps.database.entities.UserEntry
+import app.aaps.database.entities.ValueWithUnit
+import kotlinx.coroutines.test.runTest
+import kotlin.io.path.createTempDirectory
+import kotlin.test.AfterTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+class LocalTargetReceiptTest {
+    private val dir = createTempDirectory("target-receipt")
+    private val db = JvmAppDatabaseBuilder().provideAppDatabase("$dir/test.db")
+    private val dao = db.temporaryTargetDao
+    private val issued = 100_000L
+    private val marker = "copilot:manual:meal:sample:eating-soon"
+    private val target = TemporaryTarget(timestamp = issued + 1, duration = 1_800_000, reason = TemporaryTarget.Reason.EATING_SOON,
+        highTarget = 100.0, lowTarget = 100.0)
+
+    @AfterTest fun close() { db.close(); dir.toFile().deleteRecursively() }
+    private suspend fun read(m: String = marker) = dao.recordedTarget(m, issued, issued + 9_000, 100.0, 30, target.reason)
+    private suspend fun audit(id: Long, m: String = marker, at: Long = issued + 2,
+                              source: UserEntry.Sources = UserEntry.Sources.NSClient, linked: Boolean = true) {
+        val values = if (linked) listOf(ValueWithUnit.SimpleString(checkNotNull(LocalTargetReceipt.link(m, id)))) else emptyList()
+        db.userEntryDao.insert(UserEntry(timestamp = at, action = UserEntry.Action.TT, source = source, note = m, values = values))
+    }
+
+    @Test fun identicalValuesAndTimesDoNotSubstituteForTheLinkedRow() = runTest {
+        val first = dao.insert(target.copy())
+        val other = dao.insert(target.copy())
+        assertNull(read())
+        audit(first)
+        assertEquals(first, read()?.id)
+        dao.update(target.copy(id = first, isValid = false))
+        assertNull(read())
+        assertEquals(other, dao.findById(other)?.id)
+    }
+
+    @Test fun legacyDuplicateAndWrongSourceCannotConfirm() = runTest {
+        val id = dao.insert(target.copy())
+        audit(id, source = UserEntry.Sources.Loop)
+        assertNull(read())
+        audit(id, linked = false)
+        assertNull(read())
+        audit(id)
+        assertNull(read())
+    }
+
+    @Test fun managedTargetMarkerAndExactCurrentFieldsAreRequired() = runTest {
+        val m = "copilot:TargetManager.v1:" + "a".repeat(32)
+        val id = dao.insert(target.copy())
+        audit(id, m)
+        assertEquals(id, read(m)?.id)
+        for (wrong in listOf(target.copy(highTarget = 99.0), target.copy(duration = 60_000),
+            target.copy(reason = TemporaryTarget.Reason.ACTIVITY), target.copy(timestamp = issued - 1))) {
+            dao.update(wrong.copy(id = id))
+            assertNull(read(m))
+        }
+        assertNull(LocalTargetReceipt.link("copilot:manual:meal:sample", id))
+        assertNull(LocalTargetReceipt.link(m, 0))
+    }
+
+    @Test fun lateInsertAndAuditBeforeTargetAreNotProof() = runTest {
+        val id = dao.insert(target.copy(timestamp = issued + 8_000))
+        audit(id, at = issued + 8_001)
+        assertNull(read())
+        val m = "copilot:manual:meal:other:eating-soon"
+        val early = dao.insert(target.copy())
+        audit(early, m, at = issued)
+        assertNull(read(m))
+    }
+}
