+package app.aaps.core.nssdk.localmodel.clientcontrol
+
+import app.aaps.core.nssdk.utils.ClientControlCrypto
+import dev.whyoleg.cryptography.BinarySize.Companion.bytes
+import dev.whyoleg.cryptography.CryptographyProvider
+import dev.whyoleg.cryptography.DelicateCryptographyApi
+import dev.whyoleg.cryptography.algorithms.AES
+import dev.whyoleg.cryptography.algorithms.HKDF
+import dev.whyoleg.cryptography.algorithms.SHA256
+import dev.whyoleg.cryptography.random.CryptographyRandom
+import kotlin.io.encoding.Base64
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.json.*
+
+/** Immutable wire catalog, not authenticated access, a live source or insulin-delivery evidence. */
+class ComboHistoryReadReply private constructor(
+    private val clientId: String,
+    private val masterInstallId: String,
+    private val snapshotId: String,
+    private val pumpBinding: String,
+    private val reads: List<Read>,
+    private val unscopedCorruptReads: Int,
+    private val writerFailed: Boolean
+) {
+    class Read(
+        val readId: String, val byteCount: Int, val sha256: String,
+        val closed: Boolean, val corrupt: Boolean, val adverse: Boolean, val readFailed: Boolean
+    ) {
+        override fun toString() = "ComboReplyRead(redacted)"
+    }
+
+    private val totalBytes = reads.sumOf { it.byteCount.toLong() }
+    private val digest = operation {
+        val plain = buildString {
+            append(listOf("aaps-combo-inventory-v1", snapshotId, pumpBinding, reads.size,
+                totalBytes, unscopedCorruptReads, writerFailed).joinToString("|")); append('\n')
+            reads.forEach { row ->
+                append(listOf(row.readId, row.byteCount, row.sha256, row.closed, row.corrupt,
+                    row.adverse, row.readFailed).joinToString("|")); append('\n')
+            }
+        }.encodeToByteArray()
+        try { ClientControlCrypto.bytesToHex(CryptographyProvider.Default.get(SHA256).hasher().hashBlocking(plain)) }
+        finally { plain.fill(0) }
+    }
+
+    /** The owner authenticates the request and rechecks source/lifecycle/deadline before publishing. */
+    fun seal(request: ComboHistoryReadRequest, secret: ByteArray, now: Long, chunk: ByteArray? = null): ByteArray = operation {
+        require(request.clientId == clientId && request.masterInstallId == masterInstallId)
+        require(now >= request.issuedAt && now < request.validUntil && secret.size == 32)
+        val context: ByteArray
+        val plain: ByteArray
+        when (val query = request.query) {
+            is ComboHistoryReadRequest.Inventory -> {
+                require(chunk == null)
+                val start = if (query.snapshotId == null) 0 else {
+                    require(query.snapshotId == snapshotId)
+                    val previous = reads.indexOfFirst { it.readId == query.afterReadId }
+                    require(previous >= 0 && previous < reads.lastIndex)
+                    previous + 1
+                }
+                val end = minOf(reads.size, start + query.limit)
+                context = listOf("aaps-combo-inventory-page-v1", "master-to-client", "aes-256-gcm",
+                    clientId, masterInstallId, request.requestId, request.counter, request.issuedAt, request.validUntil,
+                    query.snapshotId ?: "-", query.afterReadId ?: "-", query.limit).joinToString("|").encodeToByteArray()
+                plain = buildJsonObject {
+                    put("version", 1); put("snapshotId", snapshotId); put("pumpBinding", pumpBinding); put("sha256", digest)
+                    put("totalReads", reads.size); put("totalBytes", totalBytes)
+                    put("unscopedCorruptReads", unscopedCorruptReads); put("writerFailed", writerFailed)
+                    put("hasMore", end < reads.size)
+                    put("reads", JsonArray(reads.subList(start, end).map { row -> buildJsonObject {
+                        put("readId", row.readId); put("byteCount", row.byteCount); put("sha256", row.sha256)
+                        put("closed", row.closed); put("corrupt", row.corrupt)
+                        put("adverse", row.adverse); put("readFailed", row.readFailed)
+                    } }))
+                }.toString().encodeToByteArray()
+            }
+            is ComboHistoryReadRequest.Chunk -> {
+                require(query.snapshotId == snapshotId && query.pumpBinding == pumpBinding)
+                val row = reads.firstOrNull { it.readId == query.readId } ?: invalid()
+                require(row.sha256 == query.sha256 && row.byteCount == query.totalBytes)
+                require(chunk != null && chunk.size == query.length)
+                context = listOf("aaps-combo-journal-chunk-v1", "master-to-client", "aes-256-gcm",
+                    clientId, masterInstallId, request.requestId, snapshotId, row.readId, pumpBinding, row.sha256,
+                    request.counter, request.issuedAt, request.validUntil, row.byteCount, query.offset, query.length)
+                    .joinToString("|").encodeToByteArray()
+                plain = chunk.copyOf()
+            }
+        }
+        try {
+            require(plain.size in 1..if (request.query is ComboHistoryReadRequest.Inventory) 16_384 else 32_768)
+            encrypt(secret, context, plain)
+        } finally { plain.fill(0) }
+    }
+
+    override fun toString() = "ComboHistoryReadReply(redacted)"
+
+    companion object {
+        private val UUID = Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+        private val HASH = Regex("[0-9a-f]{64}")
+
+        fun create(clientId: String, masterInstallId: String, snapshotId: String, pumpBinding: String,
+                   reads: List<Read>, unscopedCorruptReads: Int, writerFailed: Boolean): ComboHistoryReadReply = operation {
+            require(listOf(clientId, masterInstallId, snapshotId).all(UUID::matches) && clientId != masterInstallId)
+            require(HASH.matches(pumpBinding) && reads.size <= 4096 && unscopedCorruptReads in 0..4096)
+            val copy = reads.toList()
+            require(copy.size <= 4096 && copy.size + unscopedCorruptReads <= 4096)
+            require(copy.all { UUID.matches(it.readId) && HASH.matches(it.sha256) && it.byteCount in 1..2 * 1024 * 1024 })
+            require(copy.zipWithNext().all { (a, b) -> a.readId < b.readId })
+            require(copy.sumOf { it.byteCount.toLong() } <= 32L * 1024 * 1024)
+            ComboHistoryReadReply(clientId, masterInstallId, snapshotId, pumpBinding, copy, unscopedCorruptReads, writerFailed)
+        }
+
+        @OptIn(DelicateCryptographyApi::class)
+        private fun encrypt(secret: ByteArray, context: ByteArray, plain: ByteArray): ByteArray {
+            val owned = secret.copyOf()
+            try {
+                val salt = CryptographyRandom.nextBytes(32)
+                val iv = CryptographyRandom.nextBytes(12)
+                val provider = CryptographyProvider.Default
+                val key = provider.get(HKDF).secretDerivation(SHA256, 32.bytes, salt, context)
+                    .deriveSecretToByteArrayBlocking(owned)
+                val cipher = try {
+                    provider.get(AES.GCM).keyDecoder().decodeFromByteArrayBlocking(AES.Key.Format.RAW, key)
+                        .cipher().encryptWithIvBlocking(iv, plain, context)
+                } finally { key.fill(0) }
+                return buildJsonObject {
+                    put("version", 1); put("saltB64", Base64.encode(salt)); put("ivB64", Base64.encode(iv))
+                    put("ciphertextB64", Base64.encode(cipher))
+                }.toString().encodeToByteArray().also { require(it.size <= 48 * 1024) }
+            } finally { owned.fill(0) }
+        }
+
+        private inline fun <T> operation(block: () -> T): T = try { block() }
+        catch (cancelled: CancellationException) { throw cancelled }
+        catch (_: Exception) { invalid() }
+        private fun invalid(): Nothing = throw IllegalArgumentException("combo_history_reply_invalid")
+    }
+}
